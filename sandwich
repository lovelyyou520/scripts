        create("UIStroke", {Color = Color3.fromRGB(45, 45, 45), Thickness = 1}, txtBox)
        
        Config[configKey] = tostring(defaultText)
        txtBox.FocusLost:Connect(function()
            Config[configKey] = txtBox.Text
        end)
        return frame
    end

    local function AddButton(parentCard, buttonText, callback)
        local frame = create("Frame", {Size = UDim2.new(1, 0, 0, 44), BackgroundTransparency = 1}, parentCard)
        addRowDivider(frame)
        local btn = create("TextButton", {Size = UDim2.new(1, -20, 0, 30), Position = UDim2.new(0, 10, 0.5, -15), BackgroundColor3 = Color3.fromRGB(30, 30, 30), Text = buttonText, TextColor3 = Color3.fromRGB(255, 255, 255), Font = Enum.Font.GothamBold, TextSize = 12}, frame)
        create("UICorner", {CornerRadius = UDim.new(0, 6)}, btn)
        local btnStroke = create("UIStroke", {Color = Color3.fromRGB(45, 45, 45), Thickness = 1}, btn)
        
        btn.MouseButton1Click:Connect(function()
            playClickSound()
            if callback then callback() end
        end)
        btn.MouseEnter:Connect(function()
            TweenService:Create(btn, TweenInfo.new(0.15), {BackgroundColor3 = Color3.fromRGB(60, 60, 70), TextColor3 = Color3.fromRGB(255, 255, 255)}):Play()
            TweenService:Create(btnStroke, TweenInfo.new(0.15), {Color = Color3.fromRGB(200, 200, 200)}):Play()
        end)
        btn.MouseLeave:Connect(function()
            TweenService:Create(btn, TweenInfo.new(0.15), {BackgroundColor3 = Color3.fromRGB(30, 30, 30), TextColor3 = Color3.fromRGB(255, 255, 255)}):Play()
            TweenService:Create(btnStroke, TweenInfo.new(0.15), {Color = Color3.fromRGB(45, 45, 45)}):Play()
        end)
        
        return frame
    end

