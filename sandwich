    local settingsSec = AddSection("Essential Settings", true)
    AddToggle(settingsSec, "Auto Farm", "AutoFarm", function(state)
        if state then
            triggerNotification("Auto Farm Enabled!", Color3.fromRGB(100, 255, 100))
            task.spawn(function()
                local currentToaster = 1
                while Config.AutoFarm do
                    local plot = findPlayerPlot()
                    if plot then
                        local plotName = tostring(plot.Name)
                        local plotNum = string.match(plotName, "%d+")
                        if plotNum == "5" or plotNum == "6" then
                            triggerNotification("Plot " .. plotNum .. " not supported. Rejoin!", Color3.fromRGB(255, 100, 100))
                            Config.AutoFarm = false
                            break
                        end
                        local coords = plotCoordinates[plotNum]
                        if coords then
                            local char = LocalPlayer.Character
                            if char and char:FindFirstChild("HumanoidRootPart") and VirtualInputManager then
                                for i = 1, #coords do
                                    if not Config.AutoFarm then break end
                                    if coords[i] then
                                        char.HumanoidRootPart.CFrame = coords[i]
                                        task.wait(0.2)
                                        if i == 2 then
                                            VirtualInputManager:SendKeyEvent(true, Enum.KeyCode.W, false, game)
                                            task.wait(2)
                                            VirtualInputManager:SendKeyEvent(false, Enum.KeyCode.W, false, game)
                                        else
                                            VirtualInputManager:SendKeyEvent(true, Enum.KeyCode.E, false, game)
                                            task.wait(2)
                                            VirtualInputManager:SendKeyEvent(false, Enum.KeyCode.E, false, game)
                                        end
                                        task.wait(2)
                                    end
                                end
                                if not Config.AutoFarm then break end
                                local toasters = plot:FindFirstChild("Toasters")
                                if toasters then
                                    local toasterObject = toasters:FindFirstChild("Toaster" .. currentToaster)
                                    if toasterObject then
                                        local collectionFolder = plot:FindFirstChild("CollectionButton")
                                        if collectionFolder then
                                            local collectionBtn = collectionFolder:FindFirstChild("CollectionButton1")
                                            if collectionBtn and (collectionBtn:IsA("Model") or collectionBtn:IsA("BasePart")) then
                                                pcall(function()
                                                    if collectionBtn:IsA("Model") then
                                                        char.HumanoidRootPart.CFrame = collectionBtn:GetPivot()
                                                    else
                                                        char.HumanoidRootPart.CFrame = collectionBtn.CFrame
                                                    end
                                                end)
                                                task.wait(0.5)
                                            end
                                        end
                                        local amount = tonumber(Config["ToasterAmount" .. currentToaster]) or 100
                                        if amount > 0 then
                                            triggerNotification("Auto Farm: Duping Toaster " .. currentToaster .. "...", Color3.fromRGB(100, 200, 255))
                                            task.spawn(function()
                                                fireRemoteMultipleTimes(toasterObject, "toasters", amount)
                                            end)
                                        end
                                    else
                                        triggerNotification("Auto Farm: Toaster " .. currentToaster .. " missing!", Color3.fromRGB(255, 100, 100))
                                    end
                                else
                                    triggerNotification("Auto Farm: Toasters folder missing!", Color3.fromRGB(255, 100, 100))
                                end
                                currentToaster = currentToaster + 1
                                if currentToaster > 5 then currentToaster = 1 end
                                task.wait(2)
                            else
                                task.wait(0.5)
                            end
                        else
                            task.wait(0.5)
                        end
                    else
                        task.wait(0.5)
                    end
                end
            end)
        else
            triggerNotification("Auto Farm Disabled.", Color3.fromRGB(255, 100, 100))
            if VirtualInputManager then
                pcall(function() VirtualInputManager:SendKeyEvent(false, Enum.KeyCode.E, false, game) end)
            end
        end
    end)

