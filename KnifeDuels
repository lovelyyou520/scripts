-- Silent Aim via mouse movement (no hook)
local function doSilentAim()
	if not Toggles.SilentAimToggle.Value then return end
	local target = getClosestPlayerInFOV()
	if target then
		local hitPart = target.Character:FindFirstChild(Options.HitPartDropdown.Value)
		if hitPart then
			local screenPos, onScreen = Camera:WorldToViewportPoint(hitPart.Position)
			if onScreen then
				Mouse.Move(screenPos.X, screenPos.Y)
			end
		end
	end
end

-- Triggerbot
local lastTriggerTime = 0
local TRIGGER_COOLDOWN = 0.08

-- Intercept mouse clicks for Silent Aim + Triggerbot
UserInputService.InputBegan:Connect(function(input, gameProcessed)
	if gameProcessed then return end
	if input.UserInputType == Enum.UserInputType.MouseButton1 then
		-- Silent Aim: move mouse before click
		doSilentAim()

		-- Triggerbot: auto click if enabled
		if Toggles.TriggerbotToggle.Value then
			local now = tick()
			if now - lastTriggerTime >= TRIGGER_COOLDOWN then
				local target = getClosestPlayerInFOV()
				if target and isTargetVisible(target) then
					if Options.TriggerbotMouse.Value == "Mouse1" then
						mouse1click()
					else
						mouse2click()
					end
					lastTriggerTime = now
				end
			end
		end
	end
end)

