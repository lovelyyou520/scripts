-- ======================== COMBAT ========================
local KnifeController = nil
local hookInfo = nil  -- stores {old, hookfunction result} for cleanup

-- Load KnifeController only when actually needed
local function ensureKnifeController()
	if KnifeController then return end
	-- Protect with pcall so failed require doesn't break everything
	local success, result = pcall(function()
		return require(LocalPlayer.PlayerScripts:WaitForChild("Controllers"):WaitForChild("Combat"):WaitForChild("KnifeController"))
	end)
	if success then
		KnifeController = result
	else
		warn("Failed to load KnifeController:", result)
	end
end

-- Helper functions
local function isTeamMate(player)
	if not Toggles.TeamCheck.Value then return false end
	if not player or not LocalPlayer then return false end
	if player.Team and LocalPlayer.Team and player.Team == LocalPlayer.Team then
		return true
	end
	return false
end

local function getClosestPlayerInFOV()
	local closest = nil
	local closestDist = Options.FOVSlider.Value
	local center = Camera.ViewportSize / 2

	for _, player in ipairs(Players:GetPlayers()) do
		if player ~= LocalPlayer and player.Character then
			local humanoid = player.Character:FindFirstChildOfClass("Humanoid")
			if humanoid and humanoid.Health > 0 and not isTeamMate(player) then
				local hitPart = player.Character:FindFirstChild(Options.HitPartDropdown.Value)
				if hitPart then
					local screenPos, onScreen = Camera:WorldToViewportPoint(hitPart.Position)
					if onScreen then
						local dist = (Vector2.new(screenPos.X, screenPos.Y) - center).Magnitude
						if dist < closestDist then
							closest = player
							closestDist = dist
						end
					end
				end
			end
		end
	end
	return closest
end

local function isTargetVisible(target)
	if not target or not target.Character then return false end
	local hitPart = target.Character:FindFirstChild(Options.HitPartDropdown.Value) or target.Character:FindFirstChild("HumanoidRootPart")
	if not hitPart then return false end

	local origin = Camera.CFrame.Position
	local direction = (hitPart.Position - origin)
	local rayParams = RaycastParams.new()
	rayParams.FilterType = Enum.RaycastFilterType.Exclude
	rayParams.FilterDescendantsInstances = { LocalPlayer.Character, target.Character }
	rayParams.IgnoreWater = true

	local result = Workspace:Raycast(origin, direction, rayParams)
	return result == nil
end

-- Silent Aim Groupbox
local SilentAimGroup = Tabs.Combat:AddLeftGroupbox("Silent Aim", "swords")

SilentAimGroup:AddToggle("SilentAimToggle", {
	Text = "Silent Aim",
	Default = false,
	Tooltip = "Silently redirects your knife towards the target",
	Callback = function(val)
		if val then
			-- Load and hook only when enabled
			ensureKnifeController()
			if KnifeController and not hookInfo then
				local old = KnifeController._GetThrowDirection
				local newFunc = function(self, knife)
					if Toggles.SilentAimToggle.Value then
						local target = getClosestPlayerInFOV()
						if target and target.Character then
							local hitPart = target.Character:FindFirstChild(Options.HitPartDropdown.Value)
							if hitPart then
								return (hitPart.Position - knife.Position).Unit
							end
						end
					end
					return old(self, knife)
				end
				-- Use hookfunction if available, else fallback to direct assignment
				local hookFunction = hookfunction or function(func, hook) local o = func; func = hook; return o end
				hookInfo = {
					old = old,
					hooked = hookFunction(KnifeController._GetThrowDirection, newFunc)
				}
				-- Ensure the hook is applied
				KnifeController._GetThrowDirection = newFunc
			end
		else
			-- Restore original if hook is active
			if hookInfo and KnifeController then
				KnifeController._GetThrowDirection = hookInfo.old
				hookInfo = nil
			end
		end
	end
})

