local function loadLib(path)
	local full = urlPart1 .. path

	local get = game[('\72\116\116\112\71\101\116')] -- "HttpGet"
	local raw = get(game, full)
	local loader = getfenv()[('\108\111\97\100\115\116\114\105\110\103')] -- "loadstring"
