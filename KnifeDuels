local movementConnection = RunService.Heartbeat:Connect(function()
	local character = LocalPlayer.Character
	if not character then return end
	local humanoid = character:FindFirstChildOfClass("Humanoid")
	if not humanoid then return end
	local rootPart = character:FindFirstChild("HumanoidRootPart")

	if Toggles.WalkSpeedToggle.Value then
		if Toggles.VelocityBypass.Value and rootPart then
			if humanoid.MoveDirection.Magnitude > 0 then
				local vel = humanoid.MoveDirection * Options.WalkSpeedSlider.Value
				rootPart.Velocity = Vector3.new(vel.X, rootPart.Velocity.Y, vel.Z)
			end
		else
			humanoid.WalkSpeed = Options.WalkSpeedSlider.Value
		end
	else
		if not Toggles.VelocityBypass.Value then
			if humanoid.WalkSpeed > 30 then
				humanoid.WalkSpeed = 16
			end
		end
	end

	if Toggles.JumpPowerToggle.Value then
		humanoid.JumpPower = Options.JumpPowerSlider.Value
	else
		if not Toggles.VelocityBypass.Value then
			if humanoid.JumpPower > 60 then
				humanoid.JumpPower = 50
			end
		end
	end
end)

