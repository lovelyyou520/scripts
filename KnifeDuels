local function getClosestPlayerInFOV()
    local closest = nil
    local closestDist = Options.FOVSlider.Value
    local cam = workspace.CurrentCamera
    local center = cam.ViewportSize / 2
    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer and player.Character then
            local humanoid = player.Character:FindFirstChildOfClass("Humanoid")
            if humanoid and humanoid.Health > 0 then
                local hitPart = player.Character:FindFirstChild(Options.HitPartDropdown.Value)
                if hitPart then
                    local screenPos, onScreen = workspace.CurrentCamera:WorldToViewportPoint(hitPart.Position)
                    if onScreen then
                        local dist = (Vector2.new(screenPos.X, screenPos.Y) - center).Magnitude
                        if dist < closestDist then
                            closest = player
                            closestDist = dist
                        end
                    end
                end
            end
        end
    end
    return closest
end

-- Wallcheck (raycast from camera to target, ignore local + target character)
local function isVisible(target)
    if not target or not target.Character then return false end
    local hitPart = target.Character:FindFirstChild(Options.HitPartDropdown.Value) or target.Character:FindFirstChild("HumanoidRootPart")
    if not hitPart then return false end

    local origin = Camera.CFrame.Position
    local direction = (hitPart.Position - origin)
    local rayParams = RaycastParams.new()
    rayParams.FilterType = Enum.RaycastFilterType.Exclude
    rayParams.FilterDescendantsInstances = {LocalPlayer.Character, target.Character}
    rayParams.IgnoreWater = true

    local result = Workspace:Raycast(origin, direction, rayParams)
    return result == nil -- nothing hit = clear line of sight
end

local lastTrigger = 0
local TRIGGER_COOLDOWN = 0.08 -- 80ms, adjust if needed

local OriginalGetThrowDirection = KnifeController._GetThrowDirection
KnifeController._GetThrowDirection = function(self, knife)
    if Toggles.SilentAimToggle.Value then
        local target = getClosestPlayerInFOV()
        if target and target.Character then
            local hitPart = target.Character:FindFirstChild(Options.HitPartDropdown.Value)
            if hitPart then
                return (hitPart.Position - knife.Position).Unit
            end
        end
    end
    return OriginalGetThrowDirection(self, knife)
end

Library:OnUnload(function()
    KnifeController._GetThrowDirection = OriginalGetThrowDirection
end)

-- Triggerbot loop
table.insert(connections, RunService.RenderStepped:Connect(function()
    if not Toggles.TriggerbotToggle.Value then return end

    local now = tick()
    if now - lastTrigger < TRIGGER_COOLDOWN then return end

    local target = getClosestPlayerInFOV()
    if target and isVisible(target) then
        local button = Options.TriggerbotMouse.Value
        if button == "Mouse1" then
            mouse1click()
        else
            mouse2click()
        end
        lastTrigger = now
    end
end))

