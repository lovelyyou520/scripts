-- ESP System
local espHighlights = {}

VisualsGroup:AddToggle("ESPToggle", {
	Text = "Enable ESP",
	Default = false,
	Tooltip = "Highlights players (Green = Teammate, Red = Enemy)"
}):AddColorPicker("ESPColor", {
	Default = Color3.fromRGB(255, 0, 0),
	Title = "Enemy Color (override)"
})

local function updateESP()
	for _, player in ipairs(Players:GetPlayers()) do
		if player ~= LocalPlayer and player.Character then
			if Toggles.ESPToggle.Value then
				local highlight = espHighlights[player]
				if not highlight then
					highlight = Instance.new("Highlight")
					highlight.FillTransparency = 0.5
					highlight.OutlineTransparency = 0
					espHighlights[player] = highlight
				end
				highlight.Parent = player.Character

				if isTeamMate(player) then
					highlight.FillColor = Color3.fromRGB(0, 255, 0)
					highlight.OutlineColor = Color3.fromRGB(0, 255, 0)
				else
					highlight.FillColor = Options.ESPColor.Value
					highlight.OutlineColor = Options.ESPColor.Value
				end
			else
				if espHighlights[player] then
					espHighlights[player]:Destroy()
					espHighlights[player] = nil
				end
			end
		end
	end
end

-- Clean up ESP on player leaving
local function onPlayerRemoving(player)
	if espHighlights[player] then
		espHighlights[player]:Destroy()
		espHighlights[player] = nil
	end
end

Players.PlayerRemoving:Connect(onPlayerRemoving)

