table.insert(connections, RunService.Heartbeat:Connect(function()
    local char = LocalPlayer.Character
    if char and char:FindFirstChild("Humanoid") then
        local hum = char.Humanoid
        local root = char:FindFirstChild("HumanoidRootPart")
        
        if Toggles.WalkSpeedToggle.Value then
            if Toggles.VelocityBypass.Value and root then
                if hum.MoveDirection.Magnitude > 0 then
                    local vel = hum.MoveDirection * Options.WalkSpeedSlider.Value
                    root.Velocity = Vector3.new(vel.X, root.Velocity.Y, vel.Z)
                end
            else
                hum.WalkSpeed = Options.WalkSpeedSlider.Value
            end
        elseif not Toggles.VelocityBypass.Value then
            if hum.WalkSpeed > 30 then
                hum.WalkSpeed = 16 -- Reset if it was high and toggle turned off
            end
        end
        
        if Toggles.JumpPowerToggle.Value then
            hum.JumpPower = Options.JumpPowerSlider.Value
        elseif not Toggles.VelocityBypass.Value then
            if hum.JumpPower > 60 then
                hum.JumpPower = 50 -- Reset
            end
        end
    end
end))

