local espHighlights = {}

local function updateESP()
    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer and player.Character then
            if Toggles.ESPToggle.Value then
                if not espHighlights[player] then
                    local highlight = Instance.new("Highlight")
                    highlight.FillTransparency = 0.5
                    highlight.OutlineTransparency = 0
                    highlight.Parent = player.Character
                    espHighlights[player] = highlight
                end
                espHighlights[player].FillColor = Options.ESPColor.Value
                espHighlights[player].OutlineColor = Options.ESPColor.Value
                espHighlights[player].Parent = player.Character -- Ensure it stays on character
            else
                if espHighlights[player] then
                    espHighlights[player]:Destroy()
                    espHighlights[player] = nil
                end
            end
        end
    end
end

table.insert(connections, RunService.RenderStepped:Connect(function()
    local cam = workspace.CurrentCamera
    if Toggles.FOVToggle.Value then
        fovCircle.Visible = true
        fovCircle.Radius = Options.FOVSlider.Value
        fovCircle.Color = Options.FOVColor.Value
        fovCircle.Position = cam.ViewportSize / 2
    else
        fovCircle.Visible = false
    end
    updateESP()
end))

table.insert(connections, Players.PlayerRemoving:Connect(function(player)
    if espHighlights[player] then
