-- Triggerbot Loop
local lastTriggerTime = 0
local TRIGGER_COOLDOWN = 0.08

local triggerbotConnection = RunService.RenderStepped:Connect(function()
	if not Toggles.TriggerbotToggle.Value then return end

	local now = tick()
	if now - lastTriggerTime < TRIGGER_COOLDOWN then return end

	local target = getClosestPlayerInFOV()
	if target and isTargetVisible(target) then
		local button = Options.TriggerbotMouse.Value
		if button == "Mouse1" then
			mouse1click()
		else
			mouse2click()
		end
		lastTriggerTime = now
	end
end)

