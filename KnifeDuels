-- ESP System (BillboardGui)
local espGuis = {}

local function createESP(player)
	if espGuis[player] then return end
	if not player.Character then return end
	local head = player.Character:FindFirstChild("Head") or player.Character:FindFirstChild("HumanoidRootPart")
	if not head then return end

	local gui = Instance.new("BillboardGui")
	gui.Size = UDim2.new(0, 60, 0, 30)
	gui.Adornee = head
	gui.AlwaysOnTop = true
	gui.Parent = player.Character

	local label = Instance.new("TextLabel")
	label.Size = UDim2.new(1, 0, 1, 0)
	label.BackgroundTransparency = 1
	label.Text = player.Name
	label.TextScaled = true
	label.Font = Enum.Font.GothamBold
	label.TextColor3 = isTeamMate(player) and Color3.fromRGB(0, 255, 0) or Options.ESPColor.Value
	label.Parent = gui

	espGuis[player] = gui
end

local function updateESP()
	if not Toggles.ESPToggle.Value then
		for _, gui in pairs(espGuis) do
			gui:Destroy()
		end
		espGuis = {}
		return
	end

	for _, player in ipairs(Players:GetPlayers()) do
		if player ~= LocalPlayer and player.Character then
			if not espGuis[player] then
				createESP(player)
			end
			-- update color in case team changed
			local label = espGuis[player] and espGuis[player]:FindFirstChildOfClass("TextLabel")
			if label then
				label.TextColor3 = isTeamMate(player) and Color3.fromRGB(0, 255, 0) or Options.ESPColor.Value
			end
		end
	end
end

VisualsGroup:AddToggle("ESPToggle", {
