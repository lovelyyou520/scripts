-- FOV Circle (ScreenGui) – created only when toggled
local fovGui = nil
local fovCircle = nil

local function createFOVCircle()
	if fovGui then return end
	fovGui = Instance.new("ScreenGui")
	fovGui.Name = "FOVCircle"
	fovGui.Parent = LocalPlayer:WaitForChild("PlayerGui")

	fovCircle = Instance.new("Frame")
	fovCircle.Size = UDim2.new(0, Options.FOVSlider.Value * 2, 0, Options.FOVSlider.Value * 2)
	fovCircle.Position = UDim2.new(0.5, -Options.FOVSlider.Value, 0.5, -Options.FOVSlider.Value)
	fovCircle.BackgroundTransparency = 1
	fovCircle.BorderSizePixel = 0
	fovCircle.Visible = false
	fovCircle.Parent = fovGui

	local circleLine = Instance.new("Frame")
	circleLine.Size = UDim2.new(1, 0, 1, 0)
	circleLine.BackgroundTransparency = 0.8
	circleLine.BorderSizePixel = 2
	circleLine.BorderColor3 = Options.FOVColor.Value
	circleLine.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
	circleLine.ClipsDescendants = true
	circleLine.Parent = fovCircle
end

local function updateFOVCircle()
	if not Toggles.FOVToggle.Value then
		if fovCircle then fovCircle.Visible = false end
		return
	end
	if not fovGui then createFOVCircle() end
	fovCircle.Visible = true
	fovCircle.Size = UDim2.new(0, Options.FOVSlider.Value * 2, 0, Options.FOVSlider.Value * 2)
	fovCircle.Position = UDim2.new(0.5, -Options.FOVSlider.Value, 0.5, -Options.FOVSlider.Value)
	local line = fovCircle:FindFirstChildOfClass("Frame")
	if line then line.BorderColor3 = Options.FOVColor.Value end
end

VisualsGroup:AddToggle("FOVToggle", {
