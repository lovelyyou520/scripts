	fovGui:Destroy()

	-- Disconnect all connections
	for _, conn in ipairs(connections) do
		if typeof(conn) == "RBXScriptConnection" then
			conn:Disconnect()
		end
	end

	-- Clear ESP highlights
	for _, highlight in pairs(espHighlights) do
		highlight:Destroy()
	end
	espHighlights = {}

	-- Restore original throw direction if still hooked
	if hookInfo and KnifeController then
		KnifeController._GetThrowDirection = hookInfo.old
		hookInfo = nil
	end
end)
