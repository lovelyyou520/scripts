local function ApplyTheme(gui, themeName)
    local theme = ThemeColors[themeName] or ThemeColors.Purple
    if not gui then return end
    for _, obj in ipairs(gui:GetDescendants()) do
        if obj:IsA("TextLabel") or obj:IsA("TextButton") or obj:IsA("TextBox") then
            obj.TextColor3 = Color3.fromRGB(255, 255, 255)
        end
        if obj:IsA("UIGradient") then
            if type(theme.Gradient) == "table" then
                obj.Color = ColorSequence.new({
                    ColorSequenceKeypoint.new(0, theme.Gradient[1]),
                    ColorSequenceKeypoint.new(0.33, theme.Gradient[2]),
                    ColorSequenceKeypoint.new(0.66, theme.Gradient[3]),
                    ColorSequenceKeypoint.new(1, theme.Gradient[4])
                })
            else
                obj.Color = theme.Gradient
            end
        elseif obj:IsA("UIStroke") and obj.ApplyStrokeMode == Enum.ApplyStrokeMode.Border then
            obj.Color = theme.Stroke
        end
    end
end

