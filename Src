local function SaveConfig()
    local data = {}
    for k, v in pairs(Config) do
        if k == "MenuKey" then
            if v == Enum.UserInputType.MouseButton2 then
                data[k] = "RightClick"
            else
                data[k] = v.Name  -- KeyCode name
            end
        else
            data[k] = v
        end
    end
    pcall(function()
        if writefile then
            writefile(CONFIG_FILE, game:GetService("HttpService"):JSONEncode(data))
        end
    end)
end

local function LoadConfig()
    local success, content = pcall(function()
        if readfile then
            return readfile(CONFIG_FILE)
        end
        return nil
    end)
    if success and content then
        local success2, data = pcall(function()
            return game:GetService("HttpService"):JSONDecode(content)
        end)
        if success2 and data then
            for k, v in pairs(data) do
                if k == "MenuKey" then
                    if v == "RightClick" then
                        Config[k] = Enum.UserInputType.MouseButton2
                    else
                        pcall(function() Config[k] = Enum.KeyCode[v] end)
                    end
                else
                    Config[k] = v
                end
            end
        end
    end
end

