-- Heartbeat
local flyVelocity, flyGyro = nil, nil
local hbConn = RunService.Heartbeat:Connect(function()
    local char = LocalPlayer.Character
    if not char then return end
    local humanoid = char:FindFirstChild("Humanoid")
    local root = char:FindFirstChild("HumanoidRootPart")
    if not humanoid or not root then return end
    
    humanoid.WalkSpeed = Config.WalkSpeedEnabled and Config.WalkSpeed or originalWalkspeed
    if Config.JumpPowerEnabled then humanoid.JumpPower, humanoid.UseJumpPower = Config.JumpPower, true else humanoid.JumpPower = originalJumpPower end
    
    if Config.NoclipEnabled then
        for _, part in ipairs(char:GetDescendants()) do if part:IsA("BasePart") then part.CanCollide = false end end
    end
    
    if Config.FlyEnabled then
        if not flyVelocity or flyVelocity.Parent ~= root then
            flyVelocity = Instance.new("BodyVelocity")
            flyVelocity.MaxForce = Vector3.new(1, 1, 1) * 9e9
            flyVelocity.Velocity = Vector3.new(0, 0, 0)
            flyVelocity.Parent = root
            
            flyGyro = Instance.new("BodyGyro")
            flyGyro.MaxTorque = Vector3.new(1, 1, 1) * 9e9
            flyGyro.CFrame = root.CFrame
            flyGyro.Parent = root
        end
        local camCF, dir = Camera.CFrame, Vector3.new(0, 0, 0)
        if UserInputService:IsKeyDown(Enum.KeyCode.W) then dir = dir + camCF.LookVector end
        if UserInputService:IsKeyDown(Enum.KeyCode.S) then dir = dir - camCF.LookVector end
        if UserInputService:IsKeyDown(Enum.KeyCode.D) then dir = dir + camCF.RightVector end
        if UserInputService:IsKeyDown(Enum.KeyCode.A) then dir = dir - camCF.RightVector end
        if UserInputService:IsKeyDown(Enum.KeyCode.Space) then dir = dir + Vector3.new(0, 1, 0) end
        if UserInputService:IsKeyDown(Enum.KeyCode.LeftShift) then dir = dir - Vector3.new(0, 1, 0) end
        flyVelocity.Velocity = dir.Magnitude > 0 and dir.Unit * Config.FlySpeed or Vector3.new(0, 0, 0)
        flyGyro.CFrame = camCF
        humanoid.PlatformStand = true
    else
        if flyVelocity then flyVelocity:Destroy() flyVelocity = nil end
        if flyGyro then flyGyro:Destroy() flyGyro = nil end
        if humanoid.PlatformStand then humanoid.PlatformStand = false end
    end
end)
table.insert(connections, hbConn)

local function update2DTracerFrame(frame, from, to, color)
    local dist = (to - from).Magnitude
    frame.Size = UDim2.new(0, dist, 0, 1.2)
    frame.Position = UDim2.new(0, (from.X + to.X)/2 - dist/2, 0, (from.Y + to.Y)/2)
    frame.Rotation = math.deg(math.atan2(to.Y - from.Y, to.X - from.X))
    frame.BackgroundColor3 = color
    frame.Visible = true
end

-- ESP Loop
local function cleanESPForPlayer(plrName)
    local objs = espObjects[plrName]
    if objs then
        if objs.Highlight then objs.Highlight:Destroy() end
        if objs.Billboard then objs.Billboard:Destroy() end
        if objs.Tracer then pcall(function() objs.Tracer:Remove() end) end
        if objs.FrameTracer then objs.FrameTracer:Destroy() end
        espObjects[plrName] = nil
    end
end
local espConn = RunService.RenderStepped:Connect(function()
    if not Config.ESPEnabled then
        for plrName, _ in pairs(espObjects) do cleanESPForPlayer(plrName) end
        return
    end
        
        for _, plr in ipairs(Players:GetPlayers()) do
            if plr ~= LocalPlayer and plr.Character and plr.Character:FindFirstChild("HumanoidRootPart") then
                local char = plr.Character
                local root = char.HumanoidRootPart
                if char.Humanoid.Health > 0 then
                    local color = Color3.fromRGB(255, 255, 255)
                    local visual = espObjects[plr.Name] or {}
                    
                    if not visual.Highlight or visual.Highlight.Parent ~= char then
                        if visual.Highlight then visual.Highlight:Destroy() end
                        visual.Highlight = Instance.new("Highlight")
                        visual.Highlight.Name = "FishyESP_Outline"
                        visual.Highlight.FillTransparency = 0.75
                        visual.Highlight.OutlineTransparency = 0.1
                        visual.Highlight.Parent = char
                    end
                    visual.Highlight.FillColor = color
                    visual.Highlight.OutlineColor = Color3.fromRGB(255, 255, 255)
                    
                    if not visual.Billboard or visual.Billboard.Parent ~= root then
                        if visual.Billboard then visual.Billboard:Destroy() end
                        visual.Billboard = Instance.new("BillboardGui")
                        visual.Billboard.Name = "FishyESP_Board"
                        visual.Billboard.AlwaysOnTop = true
                        visual.Billboard.Size = UDim2.new(0, 150, 0, 45)
                        visual.Billboard.StudsOffset = Vector3.new(0, 3, 0)
                        visual.Billboard.Parent = root
                        
                        visual.Label = Instance.new("TextLabel")
                        visual.Label.Size = UDim2.new(1, 0, 1, 0)
                        visual.Label.BackgroundTransparency = 1
                        visual.Label.Font = Enum.Font.GothamBold
                        visual.Label.TextSize = 10
                        visual.Label.Parent = visual.Billboard
                    end
                    local dist = math.floor((LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart") and (LocalPlayer.Character.HumanoidRootPart.Position - root.Position).Magnitude) or 0)
                    local textArr = {}
                    if Config.ESPShowNames then table.insert(textArr, plr.DisplayName or plr.Name) end
                    if Config.ESPShowDist then table.insert(textArr, tostring(dist) .. " studs") end
                    visual.Label.Text = table.concat(textArr, "\n")
                    visual.Label.TextColor3 = color
                    
                    if Config.ESPTracers then
                        local screenPoint, onScreen = Camera:WorldToScreenPoint(root.Position)
                        if onScreen then
                            local screenStart = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y - 50)
                            local screenEnd = Vector2.new(screenPoint.X, screenPoint.Y)
                            if Drawing and Drawing.new then
                                if not visual.Tracer then visual.Tracer = Drawing.new("Line") visual.Tracer.Thickness, visual.Tracer.Transparency = 1.2, 0.65 end
                                visual.Tracer.From, visual.Tracer.To, visual.Tracer.Color, visual.Tracer.Visible = screenStart, screenEnd, color, true
                            else
                                if not visual.FrameTracer then 
                                    visual.FrameTracer = Instance.new("Frame")
                                    visual.FrameTracer.BorderSizePixel = 0
                                    visual.FrameTracer.AnchorPoint = Vector2.new(0.5, 0.5)
                                    visual.FrameTracer.Parent = TracerScreenGui
                                end
                                update2DTracerFrame(visual.FrameTracer, screenStart, screenEnd, color)
                            end
                        else
                            if visual.Tracer then visual.Tracer.Visible = false end
                            if visual.FrameTracer then visual.FrameTracer.Visible = false end
                        end
                    else
                        if visual.Tracer then visual.Tracer.Visible = false end
                        if visual.FrameTracer then visual.FrameTracer.Visible = false end
                    end
                    espObjects[plr.Name] = visual
                else
                    cleanESPForPlayer(plr.Name)
                end
            else
                cleanESPForPlayer(plr.Name)
            end
        end
        for name, _ in pairs(espObjects) do if not Players:FindFirstChild(name) then cleanESPForPlayer(name) end end
        
        if Config.ESPDroppedGun then
            local gun = getCachedDroppedGun()
            local gunPart = gun and (gun:IsA("Tool") and gun:FindFirstChild("Handle") or gun)
            if gunPart and not gunPart:FindFirstChild("DroppedGunHighlight") then
                local hl = Instance.new("Highlight")
                hl.Name = "DroppedGunHighlight"
                hl.FillColor = Color3.fromRGB(255, 215, 0)
                hl.OutlineColor = Color3.fromRGB(255, 255, 255)
                hl.FillTransparency = 0.3
                hl.OutlineTransparency = 0
                hl.Parent = gunPart
                
                local b = Instance.new("BillboardGui")
                b.Name = "DroppedGunLabel"
                b.AlwaysOnTop = true
                b.Size = UDim2.new(0, 100, 0, 30)
                b.StudsOffset = Vector3.new(0, 2, 0)
                b.Parent = gunPart
                
                local t = Instance.new("TextLabel")
                t.Size = UDim2.new(1, 0, 1, 0)
                t.BackgroundTransparency = 1
                t.Text = "SHERIFF GUN"
                t.TextColor3 = Color3.fromRGB(255, 215, 0)
                t.Font = Enum.Font.GothamBlack
                t.TextSize = 9
                t.Parent = b
            end
        end
end)
