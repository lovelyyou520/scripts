-- [[ CLEANUP & ONUNLOAD ]]
Library:OnUnload(function()
    Library.Unloaded = true
    for _, conn in ipairs(connections) do
        if typeof(conn) == "RBXScriptConnection" then
            conn:Disconnect()
        elseif type(conn) == "table" and conn.Disconnect then
            conn:Disconnect()
        end
    end
    -- clear ESP
    for plrName, objs in pairs(espObjects) do cleanESPForPlayer(plrName) end
    -- clear hitboxes
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= LocalPlayer and plr.Character then
            local root = plr.Character:FindFirstChild("HumanoidRootPart")
            if root then root.Size, root.Transparency, root.CanCollide = Vector3.new(2, 2, 1), 1, true end
        end
    end
    if FOVCircle then pcall(function() FOVCircle:Remove() end) end
    if TracerScreenGui then TracerScreenGui:Destroy() end
end)
