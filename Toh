local savedCheckpoint = nil
local checkpointClone = nil

local function setCheckpoint()
    local char = LP.Character
    if not char then return end
    local hrp = char:FindFirstChild("HumanoidRootPart")
    if not hrp then return end

    savedCheckpoint = hrp.CFrame

    if checkpointClone then
        checkpointClone:Destroy()
    end

    -- Create a dummy visual clone for client-side ESP
    char.Archivable = true
    checkpointClone = char:Clone()
    char.Archivable = false

    if checkpointClone then
        -- Clean up unnecessary components
        for _, obj in pairs(checkpointClone:GetDescendants()) do
            if obj:IsA("Script") or obj:IsA("LocalScript") or obj:IsA("Sound") or obj:IsA("ProximityPrompt") then
                obj:Destroy()
            end
            if obj:IsA("BasePart") then
                obj.Anchored = true
                obj.CanCollide = false
                obj.Transparency = 0.5 -- Make it look like a ghost
            end
        end

        checkpointClone.Parent = Workspace
        local cloneHrp = checkpointClone:FindFirstChild("HumanoidRootPart")
        if cloneHrp then
            cloneHrp.CFrame = savedCheckpoint
        end

        -- Add ESP Label
        local head = checkpointClone:FindFirstChild("Head")
        if head then
            local billboard = Instance.new("BillboardGui")
            billboard.Name = "CheckpointESP"
            billboard.Size = UDim2.new(0, 100, 0, 40)
            billboard.StudsOffset = Vector3.new(0, 2, 0)
            billboard.AlwaysOnTop = true
            billboard.Parent = head

            local label = Instance.new("TextLabel")
            label.Size = UDim2.new(1, 0, 1, 0)
            label.BackgroundTransparency = 1
            label.Text = "Checkpoint"
            label.TextColor3 = Color3.fromRGB(0, 255, 0)
            label.TextStrokeTransparency = 0
            label.TextScaled = true
            label.Parent = billboard
        end
        
        Library:Notify({Title = "Checkpoint", Description = "Checkpoint saved!", Time = 2})
    end
end

local function tpToCheckpoint()
    if not savedCheckpoint then
        Library:Notify({Title = "Error", Description = "No checkpoint set!", Time = 2})
        return
    end

    local char = LP.Character
    if not char then return end
    local hrp = char:FindFirstChild("HumanoidRootPart")
    if hrp then
        hrp.CFrame = savedCheckpoint
    end
end

