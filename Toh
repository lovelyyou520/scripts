UtilityGroup:AddToggle("FallProtectToggle", { Text = "Fall Protect (30 Studs)", Default = false, Callback = function(v) 
    fallProtectEnabled = v
    if v then
        fallProtectLoop = RunService.Heartbeat:Connect(function()
            local char = LP.Character
            if not char then return end
            local hrp = char:FindFirstChild("HumanoidRootPart")
            local humanoid = char:FindFirstChildOfClass("Humanoid")
            if not hrp or not humanoid then return end

            local currentState = humanoid:GetState()
            if currentState == Enum.HumanoidStateType.Freefall then
                if not isFalling then
                    isFalling = true
                    lastSafePos = hrp.CFrame
                    highestPos = hrp.Position.Y
                else
                    if hrp.Position.Y > highestPos then
                        highestPos = hrp.Position.Y
                        lastSafePos = hrp.CFrame
                    elseif highestPos - hrp.Position.Y >= 30 then
                        -- Teleport back to safe position
                        hrp.CFrame = lastSafePos
                        hrp.Velocity = Vector3.new(0, 0, 0)
                        isFalling = false
                        highestPos = hrp.Position.Y
                    end
                end
            else
                isFalling = false
                if currentState == Enum.HumanoidStateType.Running or currentState == Enum.HumanoidStateType.Landed then
                    lastSafePos = hrp.CFrame
                    highestPos = hrp.Position.Y
                end
            end
        end)
    else
        if fallProtectLoop then fallProtectLoop:Disconnect(); fallProtectLoop = nil end
    end
end })

