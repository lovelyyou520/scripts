-- X-Ray (See Through Walls)
local originalTransparencies = {}
SettingsGroup:AddToggle("XRayToggle", { Text = "X-Ray", Default = false, Callback = function(v)
    if v then
        for _, part in ipairs(Workspace:GetDescendants()) do
            if part:IsA("BasePart") and not part:IsDescendantOf(LP.Character) then
                -- Store original transparency to revert back later
                if not originalTransparencies[part] then
                    originalTransparencies[part] = part.Transparency
                end
                -- Make walls mostly transparent
                part.Transparency = 0.75
            end
        end
    else
        -- Revert back to original
        for part, originalTrans in pairs(originalTransparencies) do
            if part and part.Parent then
                part.Transparency = originalTrans
            end
        end
        originalTransparencies = {} -- Clear memory
    end
end })

-- ESP Functions (Always On Top enforced)
local function createESP(target, name, color, textStr)
    local highlight = target:FindFirstChild(name)
    if not highlight then
        highlight = Instance.new("Highlight")
        highlight.Name = name
        highlight.Parent = target
        highlight.FillColor = color
        highlight.OutlineColor = color
        highlight.FillTransparency = 0.5
        highlight.OutlineTransparency = 0
        highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop -- See through walls
    end
    highlight.FillColor = color
    highlight.OutlineColor = color
    highlight.Enabled = true

    if textStr and target:IsA("Model") and target.PrimaryPart then
        local billboard = target:FindFirstChild(name .. "_BB")
        if not billboard then
            billboard = Instance.new("BillboardGui")
            billboard.Name = name .. "_BB"
            billboard.Parent = target
            billboard.Size = UDim2.new(0, 100, 0, 30)
            billboard.StudsOffset = Vector3.new(0, 3, 0)
            billboard.AlwaysOnTop = true

            local text = Instance.new("TextLabel")
            text.Parent = billboard
            text.Size = UDim2.new(1, 0, 1, 0)
            text.BackgroundTransparency = 1
            text.TextColor3 = color
            text.TextStrokeTransparency = 0
            text.Font = Enum.Font.SourceSansBold
            text.TextSize = 14
        end
        billboard.TextLabel.Text = textStr
        billboard.TextLabel.TextColor3 = color
        billboard.Enabled = true
    end
end

local function removeESP(target, name)
    local highlight = target:FindFirstChild(name)
    if highlight then highlight.Enabled = false end
    local billboard = target:FindFirstChild(name .. "_BB")
    if billboard then billboard.Enabled = false end
end

-- ESP Loops
local espPlayersEnabled = false
local espBotsEnabled = false
local espTicketsEnabled = false
local espShowText = false

VisualsGroup:AddToggle("ESPShowText", { Text = "Show Text", Default = false, Callback = function(v) 
    espShowText = v
end })

local espLoop = RunService.RenderStepped:Connect(function()
    if not REQ.CharService then return end
    local chars = REQ.CharService:GetCharacters()
    
    -- Players & Bots
    for _, v in ipairs(chars) do
        if v.Done and not v.Local and v.Model and v.PrimaryPart then
            if v.AI then
                if espBotsEnabled then
                    createESP(v.Model, "BotESP", Color3.new(1, 0, 0), espShowText and v.Name or nil) -- Red for Bots
                else
                    removeESP(v.Model, "BotESP")
                end
            else
                if espPlayersEnabled then
                    local color = v.State.State == "Downed" and Color3.new(1, 1, 0) or Color3.new(1, 1, 1) -- Yellow for downed, White for normal
                    createESP(v.Model, "PlayerESP", color, espShowText and v.Name or nil)
                else
                    removeESP(v.Model, "PlayerESP")
                end
            end
        end
    end

    -- Tickets
    if REQ.Contexts then
        for _, ctx in ipairs(REQ.Contexts) do
            if type(ctx) == 'table' and ctx.CollectableIDs then
                for id, collectable in pairs(ctx.CollectableIDs) do
                    local model = collectable:GetCollectableModel()
                    if model and model.Parent then
                        if espTicketsEnabled then
                            createESP(model, "TicketESP", Color3.new(0, 0.5, 1), espShowText and "Ticket" or nil) -- Light Blue for Tickets
                        else
                            removeESP(model, "TicketESP")
                        end
                    end
                end
            end
        end
    end
end)

