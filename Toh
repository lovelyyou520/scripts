local autoFarmEnabled = false
local autoFarmInterval = 0
local autoFarmLoop = nil

local AutoFarmGroup = Tabs["Teleport"]:AddRightGroupbox("Auto Farm", "zap")

local function doAutoFarm()
    local char = LP.Character
    if not char then return end
    local hrp = char:FindFirstChild("HumanoidRootPart")
    if not hrp then return end

    local lobbyStop = Workspace:FindFirstChild("tower") 
        and Workspace.tower:FindFirstChild("sections") 
        and Workspace.tower.sections:FindFirstChild("lobby") 
        and Workspace.tower.sections.lobby:FindFirstChild("stop")
        
    if lobbyStop then
        hrp.CFrame = lobbyStop.CFrame + Vector3.new(0, 10, 0)
    end
    
    task.wait(0.5)
    
    local finishes = Workspace:FindFirstChild("tower") and Workspace.tower:FindFirstChild("finishes")
    if finishes then
        for _, target in ipairs(finishes:GetChildren()) do
            if not autoFarmEnabled then break end
            if char and hrp and char.Parent then
                hrp.CFrame = target:GetPivot() + Vector3.new(0, 3, 0)
                task.wait(0.2)
            else
                break
            end
        end
    end
end

AutoFarmGroup:AddToggle("AutoFarmToggle", { Text = "Auto Farm", Default = false, Callback = function(v) 
    autoFarmEnabled = v
    if autoFarmEnabled then
        if autoFarmLoop then task.cancel(autoFarmLoop) end
        autoFarmLoop = task.spawn(function()
            while autoFarmEnabled do
                doAutoFarm()
                if autoFarmInterval > 0 then
                    task.wait(autoFarmInterval)
                else
                    task.wait(1)
                end
            end
        end)
    else
        if autoFarmLoop then task.cancel(autoFarmLoop); autoFarmLoop = nil end
    end
end })

