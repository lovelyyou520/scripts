    local function SelectTab(tabName, btn)
        if activeTab == tabName then return end
        if activeTab then
            TweenService:Create(PageContainer, TweenInfo.new(0.3, Enum.EasingStyle.Quart, Enum.EasingDirection.Out), {GroupTransparency = 1}):Play()
            wait(0.3)
        else PageContainer.GroupTransparency = 1 end
        activeTab = tabName
        for name, page in pairs(pages) do page.Visible = (name == tabName) end
        TweenService:Create(PageContainer, TweenInfo.new(0.4, Enum.EasingStyle.Quart, Enum.EasingDirection.Out), {GroupTransparency = 0}):Play()
        for _, child in ipairs(TabContainer:GetChildren()) do
            if child:IsA("TextButton") then
                if child == btn then
                    TweenService:Create(child, TweenInfo.new(0.2), {BackgroundColor3 = Color3.fromRGB(60,60,70)}):Play()
                    if child:FindFirstChild("UIStroke") then child.UIStroke.Color = Color3.fromRGB(200,200,200) end
                else
                    TweenService:Create(child, TweenInfo.new(0.2), {BackgroundColor3 = Color3.fromRGB(25,25,30)}):Play()
                    if child:FindFirstChild("UIStroke") then child.UIStroke.Color = Color3.fromRGB(80,80,80) end
