            if waitingForKey then
                if input.UserInputType == Enum.UserInputType.Keyboard and input.KeyCode ~= Enum.KeyCode.Escape then
                    waitingForKey = false
                    Config[configKey] = input.KeyCode
                    bindBtn.Text = input.KeyCode.Name; bindBtn.TextColor3 = Color3.fromRGB(255,255,255)
                    TweenService:Create(bindStroke, TweenInfo.new(0.15), {Color = Color3.fromRGB(80,80,80)}):Play()
