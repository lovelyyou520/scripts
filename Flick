    local function AddSlider(parentCard, labelText, min, max, default, configKey, callback)
        local frame = create("Frame", {Size = UDim2.new(1,0,0,52), BackgroundTransparency = 1}, parentCard)
        addRowDivider(frame)
        create("TextLabel", {Size = UDim2.new(0.6,0,0,20), Position = UDim2.new(0,10,0,6), BackgroundTransparency = 1, Text = labelText, Font = Enum.Font.GothamMedium, TextSize = 12, TextXAlignment = Enum.TextXAlignment.Left}, frame)
        local valLabel = create("TextLabel", {Size = UDim2.new(0,50,0,20), Position = UDim2.new(1,-60,0,6), BackgroundTransparency = 1, Text = tostring(default), Font = Enum.Font.GothamBold, TextSize = 12, TextXAlignment = Enum.TextXAlignment.Right}, frame)
        local slideBar = create("TextButton", {Size = UDim2.new(1,-20,0,4), Position = UDim2.new(0,10,0,34), BackgroundColor3 = Color3.fromRGB(60,60,60), Text = "", AutoButtonColor = false}, frame)
        create("UICorner", {CornerRadius = UDim.new(1,0)}, slideBar)
        local fill = create("Frame", {Size = UDim2.new(0,0,1,0), BackgroundColor3 = Color3.fromRGB(100,100,255), BorderSizePixel = 0}, slideBar)
        create("UICorner", {CornerRadius = UDim.new(1,0)}, fill)
        local knob = create("Frame", {Size = UDim2.new(0,8,0,8), Position = UDim2.new(0,0,0.5,-4), BackgroundColor3 = Color3.fromRGB(255,255,255)}, slideBar)
        create("UICorner", {CornerRadius = UDim.new(1,0)}, knob)
        local function setValue(val)
            val = math.clamp(val, min, max)
            Config[configKey] = val
            valLabel.Text = (val == math.floor(val)) and tostring(math.floor(val)) or string.format("%.2f", val)
            local percent = (max-min>0) and ((val-min)/(max-min)) or 0
            fill.Size = UDim2.new(percent,0,1,0)
            knob.Position = UDim2.new(percent,-4,0.5,-4)
            if callback then callback(val) end SaveConfig()
        end
        local function updateFromInput(input)
            local absoluteX = slideBar.AbsolutePosition.X
            local width = slideBar.AbsoluteSize.X
            local inputX = input.Position.X
            local percentage = math.clamp((inputX - absoluteX) / (width>0 and width or 1), 0, 1)
            setValue(min + percentage*(max-min))
        end
        local dragging = false
        slideBar.InputBegan:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
                dragging = true; updateFromInput(input)
            end
        end)
        UserInputService.InputChanged:Connect(function(input)
            if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then updateFromInput(input) end
        end)
        UserInputService.InputEnded:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then dragging = false end
        end)
        frame.MouseEnter:Connect(function() TweenService:Create(frame, TweenInfo.new(0.15), {BackgroundTransparency = 0.96}):Play() end)
        frame.MouseLeave:Connect(function() TweenService:Create(frame, TweenInfo.new(0.15), {BackgroundTransparency = 1}):Play() end)
        setValue(default)
        return frame
    end

    local function AddKeybind(parentCard, labelText, defaultKey, configKey, callback)
        local frame = create("Frame", {Size = UDim2.new(1,0,0,38), BackgroundTransparency = 1}, parentCard)
