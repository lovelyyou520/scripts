    -- Render loop
    addConnection(RunService.RenderStepped:Connect(function()
        currentTarget = getClosestTargetToCursor()
        FOVCircle.Visible = Config.ShowFOV
        FOVCircle.Size = UDim2.new(0, Config.FOVRadius*2, 0, Config.FOVRadius*2)
        FOVCircle.Position = UDim2.new(0.5, -Config.FOVRadius, 0.5, -Config.FOVRadius)

        -- Hitbox ESP with expansion
        if Config.HitboxESP and currentTarget and currentTarget:FindFirstChild("Head") then
            local head = currentTarget.Head
            local pos, onScreen = Camera:WorldToViewportPoint(head.Position)
            if onScreen then
                local dist = (Camera.CFrame.Position - head.Position).Magnitude
                local baseSize = math.clamp(200 / dist, 8, 40)
                local boxSize = baseSize + (Config.HitboxExpansion * 0.5)
                HitboxBox.Visible = true
                HitboxBox.Size = UDim2.new(0, boxSize, 0, boxSize)
                HitboxBox.Position = UDim2.new(0, pos.X - boxSize/2, 0, pos.Y - boxSize/2)
                if Config.HitboxExpansion > 0 then
                    HitboxBox.UIStroke.Color = Color3.fromRGB(255,255,0)
                else
                    HitboxBox.UIStroke.Color = Color3.fromRGB(255,0,0)
                end
            else
                HitboxBox.Visible = false
            end
        else
            HitboxBox.Visible = false
        end

        if currentTarget and currentTarget:FindFirstChild("Head") then
            local head = currentTarget.Head
            if Config.ShowFOV then fovStroke.Color = Color3.fromRGB(100,255,150) end
            if Config.AimAssist then
                local targetCF = CFrame.new(Camera.CFrame.Position, head.Position)
                if Config.InstantLock then
                    Camera.CFrame = targetCF
                else
                    Camera.CFrame = Camera.CFrame:Lerp(targetCF, Config.Smoothness)
                end
            end
        else
            if Config.ShowFOV then fovStroke.Color = Color3.fromRGB(255,255,255) end
        end
    end))

    -- Click event
    addConnection(UserInputService.InputBegan:Connect(function(input, gameProcessed)
        if gameProcessed then return end
        if input.UserInputType == Enum.UserInputType.MouseButton1 then
            local myChar = LocalPlayer.Character
            if not myChar or not myChar:FindFirstChild("HumanoidRootPart") then return end
            local origin = myChar.HumanoidRootPart.Position
            if currentTarget and currentTarget:FindFirstChild("Head") then
                local headPos = currentTarget.Head.Position
                if Config.SilentAim then drawLaser(origin, headPos) end
                if Config.HitValidate then validateHit(currentTarget, headPos) end
            else
                if Config.SilentAim then drawLaser(origin, Camera.CFrame.Position + Camera.CFrame.LookVector * 100) end
            end
        end
    end))

    -- Instant Lock keybind toggle (hotkey)
    addConnection(UserInputService.InputBegan:Connect(function(input, gameProcessed)
        if gameProcessed then return end
        if input.KeyCode == Config.InstantLockKey then
            -- Toggle the InstantLock state
            Config.InstantLock = not Config.InstantLock
            -- Update the UI toggle
            if updateInstantLockToggle then
                updateInstantLockToggle(Config.InstantLock)
            end
            -- Notify
            triggerNotification("Instant Lock " .. (Config.InstantLock and "ON" or "OFF"), Color3.fromRGB(255,255,255))
        end
    end))

    -- NoClip keybind toggle
    addConnection(UserInputService.InputBegan:Connect(function(input, gameProcessed)
        if gameProcessed then return end
        if input.KeyCode == Config.NoClipKey then
            setNoClipEnabled(not Config.NoClip)
            if updateNoClipToggle then
                updateNoClipToggle(Config.NoClip)
            end
            triggerNotification("NoClip " .. (Config.NoClip and "ON" or "OFF"), Color3.fromRGB(255,255,255))
        end
    end))

    -- Menu keybind toggle
    local keyBindConnection = UserInputService.InputBegan:Connect(function(input, gameProcessed)
        if (input.KeyCode == Config.MenuKey and input.KeyCode ~= Enum.KeyCode.Unknown) or (input.UserInputType == Config.MenuKey) then
            playClickSound()
            if minimized and restoreFrame then
                if restoreFrame.Visible then
                    TweenService:Create(restoreFrame, TweenInfo.new(0.3), {GroupTransparency = 1}):Play()
                    wait(0.3)
                    restoreFrame.Visible = false
                else
                    restoreFrame.Visible = true
                    TweenService:Create(restoreFrame, TweenInfo.new(0.3), {GroupTransparency = 0}):Play()
                end
                return
            end
            if MainFrame.Visible then
                TweenService:Create(MainFrame, TweenInfo.new(0.3), {GroupTransparency = 1}):Play()
                wait(0.3)
                MainFrame.Visible = false
            else
                MainFrame.Visible = true
                TweenService:Create(MainFrame, TweenInfo.new(0.3), {GroupTransparency = 0}):Play()
            end
        end
    end)
    table.insert(connections, keyBindConnection)

    triggerNotification("FISHY HUB LOADED", Color3.fromRGB(255,255,255))
end

LoadMainHub()
