local function ApplyTheme(gui, themeName)
    local theme = ThemeColors[themeName] or ThemeColors.Purple
    if not gui then return end
    for _, obj in ipairs(gui:GetDescendants()) do
        if obj:IsA("TextLabel") or obj:IsA("TextButton") or obj:IsA("TextBox") then
            obj.TextColor3 = Color3.fromRGB(255,255,255)
        end
        if obj:IsA("UIGradient") then
            if type(theme.Gradient) == "table" then
                obj.Color = ColorSequence.new({
                    ColorSequenceKeypoint.new(0, theme.Gradient[1]),
                    ColorSequenceKeypoint.new(0.33, theme.Gradient[2]),
                    ColorSequenceKeypoint.new(0.66, theme.Gradient[3]),
                    ColorSequenceKeypoint.new(1, theme.Gradient[4])
                })
            else obj.Color = theme.Gradient end
        elseif obj:IsA("UIStroke") and obj.ApplyStrokeMode == Enum.ApplyStrokeMode.Border then
            obj.Color = theme.Stroke
        end
    end
end

-- Aimbot
local currentTarget = nil
local function getClosestTargetToCursor()
    local myChar = LocalPlayer.Character
    if not myChar then return nil end
    local maxDist = Config.FOVRadius + Config.HitboxExpansion
    local closestPlayer, shortestDist = nil, maxDist
    local screenCenter = Vector2.new(Camera.ViewportSize.X/2, Camera.ViewportSize.Y/2)
    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer and player.Character then
            local head = player.Character:FindFirstChild("Head")
            local humanoid = player.Character:FindFirstChildOfClass("Humanoid")
            if head and humanoid and humanoid.Health > 0 then
                local screenPos, onScreen = Camera:WorldToViewportPoint(head.Position)
                if onScreen then
                    local dist2D = (Vector2.new(screenPos.X, screenPos.Y) - screenCenter).Magnitude
                    local adjustedDist = math.max(dist2D - Config.HitboxExpansion, 0)
                    if adjustedDist < shortestDist then
                        local myRoot = myChar:FindFirstChild("HumanoidRootPart")
                        if myRoot then
                            local rcParams = RaycastParams.new()
                            rcParams.FilterType = Enum.RaycastFilterType.Exclude
                            rcParams.FilterDescendantsInstances = {myChar, player.Character}
                            local dir = head.Position - myRoot.Position
                            local result = Workspace:Raycast(myRoot.Position, dir, rcParams)
                            if not result then
                                shortestDist = adjustedDist
                                closestPlayer = player.Character
                            end
                        end
                    end
                end
            end
        end
    end
    return closestPlayer
end

local function drawLaser(startPos, endPos)
    local beam = Instance.new("Part")
    beam.Parent = Workspace; beam.Anchored = true; beam.CanCollide = false
    beam.Material = Enum.Material.Neon; beam.Color = Config.LaserColor; beam.Transparency = 0; beam.CastShadow = false
    local dist = (endPos - startPos).Magnitude
    beam.Size = Vector3.new(0.12, 0.12, dist)
    beam.CFrame = CFrame.lookAt(startPos, endPos) * CFrame.new(0, 0, -dist/2)
    TweenService:Create(beam, TweenInfo.new(0.18, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {Transparency = 1, Size = Vector3.new(0,0,dist)}):Play()
end

local function validateHit(targetChar, hitPos)
    local myChar = LocalPlayer.Character
    if not myChar or not myChar:FindFirstChild("HumanoidRootPart") then return end
    local myRoot = myChar.HumanoidRootPart
    local targetRoot = targetChar:FindFirstChild("HumanoidRootPart")
    if not targetRoot then return end
    local dist = (myRoot.Position - targetRoot.Position).Magnitude
    local rcParams = RaycastParams.new()
    rcParams.FilterType = Enum.RaycastFilterType.Exclude
    rcParams.FilterDescendantsInstances = {myChar, targetChar}
    local dir = hitPos - myRoot.Position
    local result = Workspace:Raycast(myRoot.Position, dir, rcParams)
    if not result then
        print(string.format("[Sacresti] ✔ Hit validated! Target: %s | Distance: %.1f studs", targetChar.Name, dist))
    else
        warn(string.format("[Sacresti] ✘ Hit blocked by: %s", result.Instance.Name))
    end
end

-- No‑Clip management
local noClipConnection = nil

local function setNoClipEnabled(state)
    Config.NoClip = state
    SaveConfig()
    if state then
        if noClipConnection then noClipConnection:Disconnect() end
        noClipConnection = RunService.Stepped:Connect(function()
            local char = LocalPlayer.Character
            if char then
                for _, part in ipairs(char:GetDescendants()) do
                    if part:IsA("BasePart") then
                        part.CanCollide = false
                    end
                end
            end
        end)
    else
        if noClipConnection then
            noClipConnection:Disconnect()
            noClipConnection = nil
            -- Restore collisions by setting them back to true once
            local char = LocalPlayer.Character
            if char then
                for _, part in ipairs(char:GetDescendants()) do
                    if part:IsA("BasePart") then
                        part.CanCollide = true
                    end
                end
            end
        end
    end
end

