        local waitingForKey = false
        Config[configKey] = defaultKey
        bindBtn.MouseButton1Click:Connect(function()
            playClickSound()
            waitingForKey = true
            bindBtn.Text = "[ PRESS ]"; bindBtn.TextColor3 = Color3.fromRGB(200,200,200)
            TweenService:Create(bindStroke, TweenInfo.new(0.15), {Color = Color3.fromRGB(255,255,255)}):Play()
        end)
