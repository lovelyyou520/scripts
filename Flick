local function create(class, props, parent)
    if class:find("Text") then
        props.TextColor3 = Color3.fromRGB(255, 255, 255)
    end
    if class:find("Frame") or class:find("Button") or class:find("Box") or class:find("Scrolling") then
        if props.BackgroundColor3 then props.BackgroundColor3 = Color3.fromRGB(30, 30, 30) end
        if not props.BackgroundTransparency or props.BackgroundTransparency < 0.6 then
            props.BackgroundTransparency = 0.2
        end
    end
    local obj = Instance.new(class)
    for k, v in pairs(props) do obj[k] = v end
    if parent then obj.Parent = parent end
    if (class:find("Frame") or class:find("Canvas") or class:find("Scrolling")) and props.BackgroundTransparency ~= 1 then
        local uiStroke = Instance.new("UIStroke")
        uiStroke.Color = Color3.fromRGB(40, 40, 40)
        uiStroke.Thickness = 0.4
        uiStroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
        uiStroke.Parent = obj
    end
    return obj
end

local function MakeDraggable(frame)
    local dragging, dragInput, dragStart, startPos
    local originalSize = frame.Size
    local lastInputPos, lastTrailTime = nil, 0
    frame.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging = true
            dragStart = input.Position
            startPos = frame.Position
            lastInputPos = input.Position
            local inputEnded
            inputEnded = input.Changed:Connect(function()
                if input.UserInputState == Enum.UserInputState.End then
                    dragging = false
                    inputEnded:Disconnect()
                    local finalDelta = input.Position - dragStart
                    TweenService:Create(frame, TweenInfo.new(0.4, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {
                        Size = originalSize,
                        Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + finalDelta.X, startPos.Y.Scale, startPos.Y.Offset + finalDelta.Y),
                        Rotation = 0
                    }):Play()
                end
            end)
        end
    end)
    frame.InputChanged:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then
            dragInput = input
        end
    end)
    UserInputService.InputChanged:Connect(function(input)
        if input ~= dragInput or not dragging then return end
        local delta = input.Position - dragStart
        local velocity = input.Position - lastInputPos
        lastInputPos = input.Position
        local targetPos = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
        local velX, velY = math.abs(velocity.X), math.abs(velocity.Y)
        local stretchX = 1 + math.clamp(velX/50, 0, 0.15) - math.clamp(velY/75, 0, 0.05)
        local stretchY = 1 + math.clamp(velY/50, 0, 0.15) - math.clamp(velX/75, 0, 0.05)
        local targetSize = UDim2.new(originalSize.X.Scale, originalSize.X.Offset*stretchX, originalSize.Y.Scale, originalSize.Y.Offset*stretchY)
        local diffX = targetSize.X.Offset - originalSize.X.Offset
        local diffY = targetSize.Y.Offset - originalSize.Y.Offset
        local adjustedPos = UDim2.new(targetPos.X.Scale, targetPos.X.Offset - diffX/2, targetPos.Y.Scale, targetPos.Y.Offset - diffY/2)
        local targetRotation = math.clamp(velocity.X * 0.5, -12, 12)
        TweenService:Create(frame, TweenInfo.new(0.15, Enum.EasingStyle.Quart, Enum.EasingDirection.Out), {
            Position = adjustedPos, Size = targetSize, Rotation = targetRotation
        }):Play()
        if tick() - lastTrailTime > 0.04 then
            lastTrailTime = tick()
            local trail = Instance.new("Frame")
            trail.Size = targetSize; trail.Position = adjustedPos; trail.Rotation = targetRotation
            trail.BackgroundColor3 = frame.BackgroundColor3; trail.BackgroundTransparency = 0.5
            trail.BorderSizePixel = 0; trail.ZIndex = frame.ZIndex - 1; trail.Parent = frame.Parent
            local existingCorner = frame:FindFirstChildOfClass("UICorner")
            if existingCorner then existingCorner:Clone().Parent = trail
            else
                local c = Instance.new("UICorner"); c.CornerRadius = UDim.new(0,10); c.Parent = trail
            end
            local existingStroke = frame:FindFirstChildOfClass("UIStroke")
            if existingStroke then
                local s = existingStroke:Clone(); s.Parent = trail
                TweenService:Create(s, TweenInfo.new(0.35), {Transparency = 1}):Play()
            end
            TweenService:Create(trail, TweenInfo.new(0.35, Enum.EasingStyle.Quart, Enum.EasingDirection.Out), {
                BackgroundTransparency = 1,
                Size = UDim2.new(trail.Size.X.Scale, trail.Size.X.Offset - 12, trail.Size.Y.Scale, trail.Size.Y.Offset - 12),
                Position = UDim2.new(trail.Position.X.Scale, trail.Position.X.Offset + 6, trail.Position.Y.Scale, trail.Position.Y.Offset + 6),
                Rotation = 0
            }):Play()
        end
    end)
end

