                elseif input.UserInputType == Enum.UserInputType.MouseButton2 then
                    waitingForKey = false
                    Config[configKey] = Enum.UserInputType.MouseButton2
                    bindBtn.Text = "RightClick"; bindBtn.TextColor3 = Color3.fromRGB(255,255,255)
                    TweenService:Create(bindStroke, TweenInfo.new(0.15), {Color = Color3.fromRGB(80,80,80)}):Play()
                    if callback then callback(Enum.UserInputType.MouseButton2) end SaveConfig()
                end
            end
        end)
        table.insert(connections, connection)
        frame.MouseEnter:Connect(function() TweenService:Create(frame, TweenInfo.new(0.15), {BackgroundTransparency = 0.96}):Play() end)
        frame.MouseLeave:Connect(function() TweenService:Create(frame, TweenInfo.new(0.15), {BackgroundTransparency = 1}):Play() end)
        return frame
    end

    -- Theme Selector
    local function CreateThemeButton(parentCard, labelText, default)
        local frame = create("Frame", {Size = UDim2.new(1,0,0,38), BackgroundTransparency = 1}, parentCard)
        addRowDivider(frame)
        create("TextLabel", {Size = UDim2.new(0.6,0,1,0), Position = UDim2.new(0,10,0,0), BackgroundTransparency = 1, Text = labelText, Font = Enum.Font.GothamMedium, TextSize = 12, TextXAlignment = Enum.TextXAlignment.Left}, frame)
        local themeBtn = create("TextButton", {Size = UDim2.new(0,110,0,20), Position = UDim2.new(1,-120,0.5,-10), BackgroundColor3 = Color3.fromRGB(25,25,30), Text = default, Font = Enum.Font.GothamBold, TextSize = 11}, frame)
        create("UICorner", {CornerRadius = UDim.new(0,4)}, themeBtn)
        create("UIStroke", {Color = Color3.fromRGB(40,40,40), Thickness = 0.4, ApplyStrokeMode = Enum.ApplyStrokeMode.Border}, themeBtn)
        local modalOverlay, modalCanvas, isClosing = nil, nil, false
        local function reverseWarpAndDestroy()
            if isClosing or not modalCanvas then return end
            isClosing = true
            local btnAbsPos = themeBtn.AbsolutePosition
            local mainAbsPos = MainFrame.AbsolutePosition
            local startPos = UDim2.new(0, btnAbsPos.X - mainAbsPos.X, 0, btnAbsPos.Y - mainAbsPos.Y)
            local startSize = UDim2.new(0, themeBtn.AbsoluteSize.X, 0, themeBtn.AbsoluteSize.Y)
            TweenService:Create(modalCanvas, TweenInfo.new(0.3, Enum.EasingStyle.Quart, Enum.EasingDirection.In), {Size = startSize, Position = startPos, GroupTransparency = 1}):Play()
            wait(0.3)
            if modalOverlay then modalOverlay:Destroy() end
            modalOverlay, modalCanvas, isClosing = nil, nil, false
        end
        local function openThemeSelector()
            if modalOverlay then return end
            isClosing = false
            local btnAbsPos = themeBtn.AbsolutePosition
            local mainAbsPos = MainFrame.AbsolutePosition
            local startPos = UDim2.new(0, btnAbsPos.X - mainAbsPos.X, 0, btnAbsPos.Y - mainAbsPos.Y)
            local startSize = UDim2.new(0, themeBtn.AbsoluteSize.X, 0, themeBtn.AbsoluteSize.Y)
            modalOverlay = create("Frame", {Size = UDim2.new(1,0,1,0), Position = UDim2.new(0,0,0,0), BackgroundColor3 = Color3.fromRGB(0,0,0), BackgroundTransparency = 0.6, ZIndex = 10}, MainFrame)
            modalOverlay.InputBegan:Connect(function(input) if input.UserInputType == Enum.UserInputType.MouseButton1 then reverseWarpAndDestroy() end end)
            modalCanvas = create("CanvasGroup", {Size = startSize, Position = startPos, BackgroundColor3 = Color3.fromRGB(25,25,30), BackgroundTransparency = 0, BorderSizePixel = 0, GroupTransparency = 1, ZIndex = 11, Active = true}, modalOverlay)
            create("UICorner", {CornerRadius = UDim.new(0,8)}, modalCanvas)
            Instance.new("UIGradient", modalCanvas).Parent = modalCanvas
            ApplyTheme(modalCanvas, Config.Theme)
            local contentFrame = create("Frame", {Size = UDim2.new(1,0,1,0), BackgroundTransparency = 1, ZIndex = 11}, modalCanvas)
            create("TextLabel", {Size = UDim2.new(1,0,0,30), Position = UDim2.new(0,0,0,5), BackgroundTransparency = 1, Text = "Select Theme", Font = Enum.Font.GothamBold, TextSize = 14}, contentFrame)
            local themeList = create("Frame", {Size = UDim2.new(1,-20,1,-50), Position = UDim2.new(0,10,0,35), BackgroundTransparency = 1}, contentFrame)
            create("UIListLayout", {SortOrder = Enum.SortOrder.LayoutOrder, Padding = UDim.new(0,10)}, themeList)
            local themes = {"Purple", "Blue", "Holographic", "Cotton Candy"}
            for _, t in ipairs(themes) do
                local btn = create("TextButton", {Size = UDim2.new(1,0,0,32), BackgroundColor3 = Color3.fromRGB(25,25,30), Text = t, Font = Enum.Font.GothamSemibold, TextSize = 12, LayoutOrder = 0}, themeList)
                create("UICorner", {CornerRadius = UDim.new(0,4)}, btn)
                create("UIStroke", {Color = Color3.fromRGB(40,40,40), Thickness = 0.4, ApplyStrokeMode = Enum.ApplyStrokeMode.Border}, btn)
                btn.MouseButton1Click:Connect(function()
                    playClickSound(); themeBtn.Text = t; Config.Theme = t; ApplyTheme(ScreenGui, t); reverseWarpAndDestroy(); SaveConfig()
                end)
            end
            local modalCloseBtn = create("TextButton", {Size = UDim2.new(0,20,0,20), Position = UDim2.new(1,-25,0,5), BackgroundColor3 = Color3.fromRGB(25,25,30), Text = "X", Font = Enum.Font.GothamBold, TextSize = 10}, contentFrame)
            create("UICorner", {CornerRadius = UDim.new(0,4)}, modalCloseBtn)
            modalCloseBtn.MouseButton1Click:Connect(function() playClickSound() reverseWarpAndDestroy() end)
            local totalItemsHeight = #themes * 42 - 10
            TweenService:Create(modalCanvas, TweenInfo.new(0.35, Enum.EasingStyle.Quart, Enum.EasingDirection.Out), {
                Size = UDim2.new(0,200,0,totalItemsHeight+70),
                Position = UDim2.new(0.5,-100,0.5,-(totalItemsHeight+70)/2),
                GroupTransparency = 0
            }):Play()
        end
        themeBtn.MouseButton1Click:Connect(function() playClickSound() openThemeSelector() end)
        frame.MouseEnter:Connect(function() TweenService:Create(frame, TweenInfo.new(0.15), {BackgroundTransparency = 0.96}):Play() end)
        frame.MouseLeave:Connect(function() TweenService:Create(frame, TweenInfo.new(0.15), {BackgroundTransparency = 1}):Play() end)
        return frame
    end

