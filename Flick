local CONFIG_FILE = "FishyHub_Config.json"
local function SaveConfig()
    local data = {}
    for k, v in pairs(Config) do
        if k == "MenuKey" or k == "InstantLockKey" or k == "NoClipKey" then
            data[k] = (v == Enum.UserInputType.MouseButton2) and "RightClick" or v.Name
        elseif k == "LaserColor" then
            data[k] = {R = v.R, G = v.G, B = v.B}
        else
            data[k] = v
        end
    end
    pcall(function()
        if writefile then
            writefile(CONFIG_FILE, game:GetService("HttpService"):JSONEncode(data))
        end
    end)
end

local function LoadConfig()
    pcall(function()
        if not readfile then return end
        local content = readfile(CONFIG_FILE)
        if content then
            local data = game:GetService("HttpService"):JSONDecode(content)
            if data then
                for k, v in pairs(data) do
                    if k == "MenuKey" or k == "InstantLockKey" or k == "NoClipKey" then
                        if v == "RightClick" then Config[k] = Enum.UserInputType.MouseButton2
                        else pcall(function() Config[k] = Enum.KeyCode[v] end) end
                    elseif k == "LaserColor" then
                        Config[k] = Color3.fromRGB(v.R, v.G, v.B)
                    else
                        Config[k] = v
                    end
                end
            end
        end
    end)
end
