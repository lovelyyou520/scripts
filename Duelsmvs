Library:OnUnload(function()
    print("Fishy Hub Unloaded!")
    if antiAfkConn then antiAfkConn:Disconnect() end
    CleanupFly()
    for _, d in pairs(ESP_Cache) do
        for _, l in ipairs(d.Lines) do l:Remove() end
        for _, q in ipairs(d.Quads) do q:Remove() end
        if d.Tracer then d.Tracer:Remove() end
    end
    for _, hl in pairs(Highlight_Cache) do hl:Destroy() end
    for part, trans in pairs(OriginalTransparencies) do if part and part.Parent then part.Transparency = trans end end
end)
