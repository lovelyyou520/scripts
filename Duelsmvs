RunService.RenderStepped:Connect(function()
    if Library.Unloaded then return end
    local lp = LP
    local myTeam = GetTeamFolder(lp)
    local cam = Workspace.CurrentCamera
    
    for _, Player in ipairs(Players:GetPlayers()) do
        if Player ~= lp then
            local validChar = Player.Character and Player.Character:FindFirstChild("HumanoidRootPart") and Player.Character:FindFirstChild("Humanoid") and Player.Character.Humanoid.Health > 0
            local pTeam = GetTeamFolder(Player)
            local col = GetTeamColor(pTeam)
            local isTeammate = (EspTeamCheck and myTeam and pTeam == myTeam)

            if HighlightEnabled and validChar and not isTeammate then
                local hl = Highlight_Cache[Player]
                if not hl then hl = Instance.new("Highlight"); hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop; hl.FillTransparency = 0.5; hl.OutlineTransparency = 0; Highlight_Cache[Player] = hl end
                hl.Parent = Player.Character; hl.Enabled = true; hl.FillColor = col
                if JumpESPEnabled then
                    local state = Player.Character.Humanoid:GetState()
                    hl.OutlineColor = (state == Enum.HumanoidStateType.Freefall or state == Enum.HumanoidStateType.Jumping) and Color3.fromRGB(255, 255, 0) or Color3.fromRGB(255, 255, 255)
                else hl.OutlineColor = Color3.fromRGB(255, 255, 255) end
            else if Highlight_Cache[Player] then Highlight_Cache[Player].Enabled = false end end

            if EspEnabled or TracersEnabled then
                if not ESP_Cache[Player] then
                    local d = { Lines = {}, Quads = {} }
                    for i = 1, 12 do local l = Drawing.new("Line"); l.Thickness=1; l.Transparency=1; l.ZIndex=1; d.Lines[i]=l end
                    for i = 1, 6 do local q = Drawing.new("Quad"); q.Thickness=0.5; q.Transparency=0.25; q.ZIndex=1; q.Filled=true; d.Quads[i]=q end
                    local tr = Drawing.new("Line"); tr.Thickness=1; tr.Transparency=1; tr.ZIndex=1; d.Tracer=tr
                    ESP_Cache[Player] = d
                end
                
                local d = ESP_Cache[Player]
                local showBox = EspEnabled and validChar and not isTeammate
                local showTracer = TracersEnabled and validChar and not isTeammate

                if showBox then
                    local hrp = Player.Character.HumanoidRootPart
                    local verts = GetCorners(hrp.CFrame * CFrame.new(0,-0.5,0), Vector3.new(3,5,3))
                    local sp, anyVis = {}, false
                    for i=1,8 do local p,v=cam:WorldToViewportPoint(verts[i]); sp[i]=Vector2.new(p.X,p.Y); if v then anyVis=true end end
                    if anyVis then
                        local edges = {{1,2},{2,6},{6,5},{5,1},{1,3},{2,4},{6,8},{5,7},{3,4},{4,8},{8,7},{7,3}}
                        for i,e in ipairs(edges) do d.Lines[i].From=sp[e[1]]; d.Lines[i].To=sp[e[2]]; d.Lines[i].Color=col; d.Lines[i].Visible=true end
                        local faces = {{1,2,6,5},{2,4,8,6},{1,2,4,3},{1,5,7,3},{5,7,8,6},{3,4,8,7}}
                        for i,f in ipairs(faces) do d.Quads[i].PointA=sp[f[1]]; d.Quads[i].PointB=sp[f[2]]; d.Quads[i].PointC=sp[f[3]]; d.Quads[i].PointD=sp[f[4]]; d.Quads[i].Color=col; d.Quads[i].Visible=true end
                    else for _,l in ipairs(d.Lines) do l.Visible=false end; for _,q in ipairs(d.Quads) do q.Visible=false end end
                else for _,l in ipairs(d.Lines) do l.Visible=false end; for _,q in ipairs(d.Quads) do q.Visible=false end end

                if showTracer then
                    local head = Player.Character:FindFirstChild("Head")
                    if head then
                        local hp, onSc = cam:WorldToViewportPoint(head.Position)
                        if onSc then
                            d.Tracer.From = Vector2.new(hp.X, hp.Y)
                            local myHrp = lp.Character and lp.Character:FindFirstChild("HumanoidRootPart")
                            if myHrp and Player.Character:FindFirstChild("HumanoidRootPart") then
                                d.Tracer.Thickness = math.clamp(100/(myHrp.Position - Player.Character.HumanoidRootPart.Position).Magnitude, 0.1, 3)
                            end
                            local dp, dv = cam:WorldToViewportPoint(head.CFrame:ToWorldSpace(CFrame.new(0,0,-15)).Position)
                            if dv then d.Tracer.To=Vector2.new(dp.X,dp.Y); d.Tracer.Color=col; d.Tracer.Visible=true else d.Tracer.Visible=false end
                        else d.Tracer.Visible=false end
                    else d.Tracer.Visible=false end
                else d.Tracer.Visible=false end
            end
        end
    end
end)

