-- ── Helpers ────────────────────────────────────────────────────────
local function GetTeamFolder(targetPlayer)
    local rg = Workspace:FindFirstChild("RunningGames")
    if not rg then return nil end
    for _, gf in ipairs(rg:GetChildren()) do
        local ap = gf:FindFirstChild("AlivePlayers")
        if ap then
            for _, tf in ipairs(ap:GetChildren()) do
                for _, pv in ipairs(tf:GetChildren()) do
                    if pv:IsA("StringValue") then
                        local userId = tonumber(pv.Value)
                        if userId and userId == targetPlayer.UserId then return tf end
                    end
                end
            end
        end
    end
    return nil
end

local function GetTeamColor(tf)
    if not tf then return Color3.fromRGB(255,255,255) end
    local n = tf.Name:lower()
    if n:find("red")    then return Color3.fromRGB(255,50,50)   end
    if n:find("blue")   then return Color3.fromRGB(50,50,255)   end
    if n:find("green")  then return Color3.fromRGB(50,255,50)   end
    if n:find("yellow") then return Color3.fromRGB(255,255,50)  end
    if n:find("purple") then return Color3.fromRGB(150,50,255)  end
    if n:find("orange") then return Color3.fromRGB(255,150,50)  end
    if n:find("pink")   then return Color3.fromRGB(255,100,200) end
    return Color3.fromRGB(255,255,255)
end

local function DoServerHop()
    local req = (syn and syn.request) or (http and http.request) or http_request or (fluxus and fluxus.request) or request
    if not req then return end
    pcall(function()
        local res = req({
            Url = "https://games.roblox.com/v1/games/" .. game.PlaceId .. "/servers/Public?sortOrder=Asc&limit=100",
            Method = "GET"
        })
        if not res or not res.Body then return end
        local data = HttpService:JSONDecode(res.Body)
        if not (data and data.data) then return end
        table.sort(data.data, function(a,b) return (tonumber(a.playing) or 0) > (tonumber(b.playing) or 0) end)
        for _, v in ipairs(data.data) do
            if type(v) == "table" and tonumber(v.playing) and tonumber(v.maxPlayers) then
                if v.playing < v.maxPlayers and v.id ~= game.JobId then
                    TeleportService:TeleportToPlaceInstance(game.PlaceId, v.id, LP)
                    break
                end
            end
        end
    end)
end

