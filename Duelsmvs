local XRayEnabled, XRayTransparency = false, 0.5
local OriginalTransparencies = {}

local function applyXRayToPart(part)
    if not part:IsA("BasePart") or part:IsDescendantOf(Workspace.CurrentCamera) then return end
    local isChar = false
    for _, p in ipairs(Players:GetPlayers()) do if p.Character and part:IsDescendantOf(p.Character) then isChar = true end end
    if not isChar then
        if not OriginalTransparencies[part] then OriginalTransparencies[part] = part.Transparency end
        part.Transparency = XRayTransparency
    end
end

local function UpdateXRay()
    if XRayEnabled then for _, obj in ipairs(Workspace:GetDescendants()) do applyXRayToPart(obj) end else
        for part, trans in pairs(OriginalTransparencies) do if part and part.Parent then part.Transparency = trans end end
        table.clear(OriginalTransparencies)
    end
end

CamGroup:AddToggle("XRayToggle", { Text = "Enable X-Ray", Default = false, Callback = function(v) XRayEnabled = v; UpdateXRay() end })
CamGroup:AddSlider("XRaySlider", { Text = "X-Ray Transparency", Default = 50, Min = 0, Max = 100, Rounding = 0, Callback = function(v) XRayTransparency = v / 100; if XRayEnabled then UpdateXRay() end end })

local function GetCorners(cf, sz)
    local h = sz/2; local Corners = {}
    for X = -1,1,2 do for Y = -1,1,2 do for Z = -1,1,2 do Corners[#Corners+1] = (cf * CFrame.new(h * Vector3.new(X,Y,Z))).Position end end end
    return Corners
end

