                        end
                    end
                else
                    local tPad, currPad, nextPad = nil, false, nil
                    local pz = Workspace:FindFirstChild("PadZones")
                    if pz then
                        for _, zName in ipairs({"PadZone1", "PadZone5"}) do
                            local z = pz:FindFirstChild(zName)
                            if z then
                                local p1, p2 = z:FindFirstChild("Pad1"), z:FindFirstChild("Pad2")
                                if p1 and p2 and p1:FindFirstChild("PlayersOnPad") and p2:FindFirstChild("PlayersOnPad") then
                                    local c1, c2 = #p1.PlayersOnPad:GetChildren(), #p2.PlayersOnPad:GetChildren()
                                    local on1, on2 = false, false
                                    for _, v in ipairs(p1.PlayersOnPad:GetChildren()) do
