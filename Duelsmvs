local function getKnife(lp)
    local char = lp.Character
    if char then
        for _, t in ipairs(char:GetChildren()) do
            if t:IsA("Tool") and t:FindFirstChild("ActivateThrowing") then return t end
        end
    end
    local bp = lp:FindFirstChild("Backpack")
    if bp then
        for _, t in ipairs(bp:GetChildren()) do
            if t:IsA("Tool") and t:FindFirstChild("ActivateThrowing") then return t end
        end
    end
end

local function getTarget(myTeam)
    local parent = myTeam.Parent
    if not parent then return nil end
    for _, tf in ipairs(parent:GetChildren()) do
        if tf ~= myTeam then
            for _, pv in ipairs(tf:GetChildren()) do
                if pv:IsA("StringValue") then
                    local userId = tonumber(pv.Value)
                    if userId then
                        local p = Players:GetPlayerByUserId(userId)
                        if p and p.Character and p.Character:FindFirstChild("HumanoidRootPart")
                           and p.Character:FindFirstChild("Humanoid") and p.Character.Humanoid.Health > 0 then
                            return p
                        end
                    end
                end
            end
        end
    end
    return nil
end

