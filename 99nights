        local charsFolder = workspace:FindFirstChild("Characters")
        
        local activePhysicalKids = {}
        if charsFolder then
            for _, childName in ipairs(lostChildNames) do
                local charObj = charsFolder:FindFirstChild(childName)
                if charObj then
                    local kidPos = nil
                    if charObj:IsA("Model") and charObj.PrimaryPart then
                        kidPos = charObj.PrimaryPart.Position
                    elseif charObj:IsA("BasePart") then
                        kidPos = charObj.Position
                    else
                        local part = charObj:FindFirstChildWhichIsA("BasePart", true)
                        if part then kidPos = part.Position end
                    end
                    
                    if kidPos then
                        table.insert(activePhysicalKids, {Name = childName, Object = charObj, Position = kidPos, IsPhysical = true})
                    end
                end
            end
        end
        
        if missingFolder then
            for i, kidName in ipairs(targetKidsList) do
