                if physicalMatch then
                    table.insert(kids, {
                        Name = kidName .. " (" .. physicalMatch.Name .. ")", 
                        Object = physicalMatch.Object, 
                        Position = physicalMatch.Position,
                        IsPhysical = true
                    })
                else
                    local kidModel = missingFolder:FindFirstChild(kidName)
                    if kidModel then
                        local kPos = nil
                        if kidModel:IsA("Model") and kidModel.PrimaryPart then
                            kPos = kidModel.PrimaryPart.Position
                        elseif kidModel:IsA("BasePart") then
                            kPos = kidModel.Position
                        else
                            local p = kidModel:FindFirstChildWhichIsA("BasePart", true)
                            if p then kPos = p.Position end
                        end
                        if kPos then
                            table.insert(kids, {Name = kidName, Object = kidModel, Position = kPos, IsPhysical = true})
                        else
                            local kidPos = missingFolder:GetAttribute(kidName)
                            if kidPos then
                                table.insert(kids, {Name = kidName, Object = kidName, Position = kidPos, IsPhysical = false})
                            end
                        end
                    else
                        local kidPos = missingFolder:GetAttribute(kidName)
                        if kidPos then
                            table.insert(kids, {Name = kidName, Object = kidName, Position = kidPos, IsPhysical = false})
                        end
                    end
                end
            end
        end
        return kids
    end
    
