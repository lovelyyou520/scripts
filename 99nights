                        pcall(function()
                            if obj:IsA("Model") and obj.PrimaryPart then
                                obj:SetPrimaryPartCFrame(CFrame.new(teleportTargetPos))
                                count = count + 1
                            elseif obj:IsA("BasePart") then
                                obj.CFrame = CFrame.new(teleportTargetPos)
                                count = count + 1
                            else
