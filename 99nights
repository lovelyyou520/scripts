        if state then
            flyBodyVelocity = Instance.new("BodyVelocity")
            flyBodyVelocity.MaxForce = Vector3.new(400000, 400000, 400000)
            flyBodyVelocity.Velocity = Vector3.zero
            flyBodyVelocity.Parent = hrp
            
            flyBodyGyro = Instance.new("BodyGyro")
            flyBodyGyro.MaxTorque = Vector3.new(400000, 400000, 400000)
            flyBodyGyro.CFrame = hrp.CFrame
            flyBodyGyro.Parent = hrp
            
            flyConnection = RunService.RenderStepped:Connect(function()
                if not flyActive then return end
                local speed = 50
                local moveVector = Vector3.zero
                if UserInputService:IsKeyDown(Enum.KeyCode.W) then
                    moveVector = moveVector + Camera.CFrame.LookVector
                end
                if UserInputService:IsKeyDown(Enum.KeyCode.S) then
                    moveVector = moveVector - Camera.CFrame.LookVector
                end
                if UserInputService:IsKeyDown(Enum.KeyCode.A) then
                    moveVector = moveVector - Camera.CFrame.RightVector
                end
                if UserInputService:IsKeyDown(Enum.KeyCode.D) then
                    moveVector = moveVector + Camera.CFrame.RightVector
                end
                if UserInputService:IsKeyDown(Enum.KeyCode.Space) then
                    moveVector = moveVector + Vector3.new(0, 1, 0)
                end
                if UserInputService:IsKeyDown(Enum.KeyCode.LeftShift) then
                    moveVector = moveVector - Vector3.new(0, 1, 0)
                end
                if moveVector.Magnitude > 0 then
                    moveVector = moveVector.Unit * speed
                    flyBodyVelocity.Velocity = moveVector
                else
                    flyBodyVelocity.Velocity = Vector3.zero
                end
                flyBodyGyro.CFrame = Camera.CFrame
            end)
        else
            if flyBodyVelocity then flyBodyVelocity:Destroy() end
            if flyBodyGyro then flyBodyGyro:Destroy() end
            if flyConnection then flyConnection:Disconnect() end
            flyBodyVelocity, flyBodyGyro, flyConnection = nil, nil, nil
        end
    end)

    -- Fling Touch
    local flingTasks = {}
    local function flingPlayer(targetPlayer, condition)
        local player = LocalPlayer
        local char = player.Character
        local hrp = char and char:FindFirstChild("HumanoidRootPart")
        local hum = char and char:FindFirstChildOfClass("Humanoid")
        if not hrp or not hum or hum.Health <= 0 then return end

        local targetChar = targetPlayer.Character
        local tHRP = targetChar and targetChar:FindFirstChild("HumanoidRootPart")
        local tHum = targetChar and targetChar:FindFirstChildOfClass("Humanoid")
        if not tHRP or not tHum or tHum.Health <= 0 then return end

        local oldCFrame = hrp.CFrame
        local oldFallen = workspace.FallenPartsDestroyHeight
        workspace.FallenPartsDestroyHeight = -50000

        hum:SetStateEnabled(Enum.HumanoidStateType.Seated, false)
        hum:ChangeState(Enum.HumanoidStateType.Physics)

        local oldTransparency = {}
        for _, p in ipairs(char:GetDescendants()) do
            if p:IsA("BasePart") then
                oldTransparency[p] = p.Transparency
                p.Transparency = 1
                p.CanCollide = false
            elseif p:IsA("Decal") then
                oldTransparency[p] = p.Transparency
                p.Transparency = 1
            end
        end

        local ang = Instance.new("BodyAngularVelocity", hrp)
        ang.Name = "FlingAngular"
        ang.AngularVelocity = Vector3.new(0, 50000, 0)
        ang.MaxTorque = Vector3.new(0, math.huge, 0)

        local start = tick()
        while condition() and tick() - start < 0.3 do
            if tHRP and tHum and tHum.Health > 0 then
                local targetPos = tHRP.Position + tHRP.Velocity * 0.1
                hrp.CFrame = CFrame.new(targetPos)
                hrp.Velocity = Vector3.zero
            else
                break
            end
            task.wait()
        end

        if ang then ang:Destroy() end
        
        for p, t in pairs(oldTransparency) do
            if p:IsA("BasePart") then
                p.Transparency = t
                p.CanCollide = true
            elseif p:IsA("Decal") then
                p.Transparency = t
            end
        end

        hum:SetStateEnabled(Enum.HumanoidStateType.Seated, true)
        hum:ChangeState(Enum.HumanoidStateType.GettingUp)
        workspace.FallenPartsDestroyHeight = oldFallen
        
        hrp.Velocity = Vector3.zero
        hrp.RotVelocity = Vector3.zero
        hrp.CFrame = oldCFrame
        
        task.wait(0.2)
    end

    local function toggleFlingTouch(enabled)
        flingTasks["FlingTouch"] = enabled
        if enabled then
            task.spawn(function()
                local player = LocalPlayer
                while flingTasks["FlingTouch"] do
                    task.wait(0.1)
                    local char = player.Character
                    local hrp = char and char:FindFirstChild("HumanoidRootPart")
                    local hum = char and char:FindFirstChildOfClass("Humanoid")
                    
                    if hrp and hum and hum.Health > 0 then
                        for _, target in ipairs(Players:GetPlayers()) do
                            if target ~= player and target.Character then
                                local tHRP = target.Character:FindFirstChild("HumanoidRootPart")
                                local tHum = target.Character:FindFirstChildOfClass("Humanoid")
                                if tHRP and tHum and tHum.Health > 0 then
                                    if (tHRP.Position - hrp.Position).Magnitude <= 5 then
                                        flingPlayer(target, function()
                                            return flingTasks["FlingTouch"]
                                        end)
                                        task.wait(0.2)
                                    end
                                end
                            end
                        end
                    end
                end
            end)
        end
    end

