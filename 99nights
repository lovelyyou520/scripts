                    "Apple", "Bandage", "Medkit", "Water", "Axe", "Sword", "Spear", "Mushroom", "Berry"
                }
            end
        end
        
        local uniqueItems = {}
        local hash = {}
        for _, v in ipairs(itemsList) do
            if not hash[v] then
                table.insert(uniqueItems, v)
                hash[v] = true
            end
        end
        
        local categories = {
            Weapons = {},
            Consumables = {},
            Resources = {},
            Other = {}
        }
        
        for _, name in ipairs(uniqueItems) do
            local lowerName = string.lower(name)
            if string.find(lowerName, "axe") or string.find(lowerName, "sword") or string.find(lowerName, "spear") or string.find(lowerName, "bat") or string.find(lowerName, "knife") or string.find(lowerName, "gun") or string.find(lowerName, "hammer") or string.find(lowerName, "club") or string.find(lowerName, "machete") then
                table.insert(categories.Weapons, name)
            elseif string.find(lowerName, "apple") or string.find(lowerName, "bandage") or string.find(lowerName, "medkit") or string.find(lowerName, "water") or string.find(lowerName, "food") or string.find(lowerName, "meat") or string.find(lowerName, "berry") or string.find(lowerName, "drink") or string.find(lowerName, "cola") or string.find(lowerName, "soup") or string.find(lowerName, "mushroom") then
                table.insert(categories.Consumables, name)
            elseif string.find(lowerName, "log") or string.find(lowerName, "stick") or string.find(lowerName, "coal") or string.find(lowerName, "stone") or string.find(lowerName, "rock") or string.find(lowerName, "leaf") or string.find(lowerName, "leaves") or string.find(lowerName, "scrap") or string.find(lowerName, "metal") or string.find(lowerName, "wood") or string.find(lowerName, "fuel") or string.find(lowerName, "oil") then
                table.insert(categories.Resources, name)
            else
                table.insert(categories.Other, name)
            end
        end
        
        for _, list in pairs(categories) do table.sort(list) end
        return categories
    end
    
