    local function getExactPosition(kidData)
        local exactPos = nil
        if kidData.IsPhysical and kidData.Object and kidData.Object.Parent then
            if kidData.Object:IsA("Model") and kidData.Object.PrimaryPart then
                exactPos = kidData.Object.PrimaryPart.Position
            elseif kidData.Object:IsA("BasePart") then
                exactPos = kidData.Object.Position
            else
                local part = kidData.Object:FindFirstChildWhichIsA("BasePart", true)
                if part then exactPos = part.Position end
            end
        elseif not kidData.IsPhysical then
            local folder = workspace:FindFirstChild("MissingKids") or (workspace:FindFirstChild("Map") and workspace.Map:FindFirstChild("MissingKids"))
            if folder then
                local model = folder:FindFirstChild(kidData.Object)
                if model then
                    if model:IsA("Model") and model.PrimaryPart then
                        exactPos = model.PrimaryPart.Position
                    elseif model:IsA("BasePart") then
                        exactPos = model.Position
                    else
                        local part = model:FindFirstChildWhichIsA("BasePart", true)
                        if part then exactPos = part.Position end
                    end
                else
                    exactPos = folder:GetAttribute(kidData.Object)
                end
            end
        end
        return exactPos or kidData.Position
    end

    local function rescueKid(kidData)
        local exactPos = getExactPosition(kidData)
        if not exactPos then
            triggerNotification("Kid position not found for " .. kidData.Name, Color3.fromRGB(255, 100, 100))
            return false
        end
        teleportTo(CFrame.new(exactPos))
        triggerNotification("Teleported to " .. kidData.Name, Color3.fromRGB(100, 255, 100))
        task.wait(0.2)
        
        local success = pcall(function()
            local rs = game:GetService("ReplicatedStorage")
            local inventory = LocalPlayer:FindFirstChild("Inventory")
            local sack = nil
            if inventory then
                for _, item in ipairs(inventory:GetChildren()) do
                    if string.find(string.lower(item.Name), "sack") then
                        sack = item
                        break
                    end
                end
            end
            
            if not sack then
                triggerNotification("No sack found in Inventory!", Color3.fromRGB(255, 100, 100))
                return
            end
            
            local targetObj = nil
            if kidData.IsPhysical and kidData.Object then
                targetObj = kidData.Object
            else
                local folder = workspace:FindFirstChild("MissingKids") or (workspace:FindFirstChild("Map") and workspace.Map:FindFirstChild("MissingKids"))
                if folder then
                    targetObj = folder:FindFirstChild(kidData.Object) or folder
                end
            end
            
            if not targetObj then
                triggerNotification("Target Object not found!", Color3.fromRGB(255, 100, 100))
                return
            end
            
            pcall(function()
                if rs.RemoteEvents.RequestHotbarItem:IsA("RemoteFunction") then
                    rs.RemoteEvents.RequestHotbarItem:InvokeServer(sack)
                else
                    rs.RemoteEvents.RequestHotbarItem:FireServer(sack)
                end
            end)
            task.wait(0.5)
            
            pcall(function()
                if rs.RemoteEvents.RequestBagStoreItem:IsA("RemoteFunction") then
                    rs.RemoteEvents.RequestBagStoreItem:InvokeServer(sack, targetObj)
                else
                    rs.RemoteEvents.RequestBagStoreItem:FireServer(sack, targetObj)
                end
            end)
            task.wait(0.8)
            
            teleportTo(CFrame.new(17.850570678710938, 4.000000953674316 + 5, 1.3775887489318848))
            task.wait(0.2)
            
            rs.RemoteEvents.RequestBagDropItem:FireServer(sack, targetObj, false)
            triggerNotification("Rescued and dropped at Camp!", Color3.fromRGB(100, 255, 100))
        end)
        return success
    end

