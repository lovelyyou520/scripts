-- FPS Booster logic
local function applyFPSBooster(enable, strength)
    if enable then
        -- Strength 1 (low): disable particles, smoke, fire, sparkles
        for _, v in ipairs(workspace:GetDescendants()) do
            if v:IsA("ParticleEmitter") or v:IsA("Fire") or v:IsA("Smoke") or v:IsA("Sparkles") then
                v.Enabled = false
            end
        end
        Lighting.GlobalShadows = false
        Lighting.ShadowSoftness = 0
        
        if strength >= 2 then
            -- Reduce render distance / texture quality
            settings().Rendering.QualityLevel = 1
            settings().Rendering.MeshPartDetailLevel = Enum.MeshPartDetailLevel.Level01
            pcall(function()
                settings().Rendering.FastGuiRendering = true
                settings().Rendering.FastTextureRendering = true
            end)
        end
        if strength >= 3 then
            -- Remove all decals/textures
            for _, obj in ipairs(workspace:GetDescendants()) do
                if obj:IsA("Decal") or obj:IsA("Texture") then
                    obj.Transparency = 0.5
                end
            end
        end
        if strength >= 4 then
            -- Turn off all lighting effects
            Lighting.Ambient = Color3.fromRGB(255,255,255)
            Lighting.Brightness = 1
            Lighting.ClockTime = 14
            Lighting.FogEnd = 100000
            Lighting.GlobalShadows = false
        end
        if strength >= 5 then
            -- Extreme: remove all non-essential parts transparency
            for _, obj in ipairs(workspace:GetDescendants()) do
                if obj:IsA("BasePart") and not obj.Parent:IsA("Model") then
                    obj.Transparency = 0.3
                end
            end
        end
    else
        -- Restore defaults
        for _, v in ipairs(workspace:GetDescendants()) do
            if v:IsA("ParticleEmitter") or v:IsA("Fire") or v:IsA("Smoke") or v:IsA("Sparkles") then
                v.Enabled = true
            end
            if v:IsA("Decal") or v:IsA("Texture") then
                v.Transparency = 0
            end
            if v:IsA("BasePart") and not v.Parent:IsA("Model") then
                v.Transparency = 0
            end
        end
        settings().Rendering.QualityLevel = 10
        settings().Rendering.MeshPartDetailLevel = Enum.MeshPartDetailLevel.Level04
        pcall(function()
            settings().Rendering.FastGuiRendering = false
            settings().Rendering.FastTextureRendering = false
        end)
        Lighting.GlobalShadows = true
        Lighting.ShadowSoftness = 0.5
        Lighting.Ambient = Color3.fromRGB(0,0,0)
    end
end

