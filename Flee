-- Movement functions for auto-hack
local movementIdx = 0
local function moveWalk(target, destination)
    local hum = target.Parent and target.Parent:FindFirstChild("Humanoid")
    if not hum then
        target.CFrame = destination
        return
    end
    local dist = (target.Position - destination.Position).Magnitude
    if dist < 0.5 then
        target.CFrame = destination
        return
    end
    local step = math.min(10, dist / 3)
    local steps = math.ceil(dist / step)
    local direction = (destination.Position - target.Position).Unit
    for i = 1, steps do
        if not target.Parent or not autoHack then return end
        hum:Move(direction, false)
        task.wait(math.random(10, 25) / 1000)
        if (target.Position - destination.Position).Magnitude < 1 then break end
    end
    hum:Move(Vector3.new(0,0,0), false)
    task.wait(0.05)
    target.CFrame = destination
end

local function moveJump(target, destination)
    local hum = target.Parent and target.Parent:FindFirstChild("Humanoid")
    if not hum then
        target.CFrame = destination
        return
    end
    hum:Move(Vector3.new(0,0,0), false)
    task.wait(0.05)
    hum:Jump()
    task.wait(0.1)
    target.CFrame = destination
    task.wait(0.05)
    hum:Move(Vector3.new(0,0,0), false)
end

local tweenSpeed = 20
local function moveTween(target, destination)
    local hum = target.Parent and target.Parent:FindFirstChild("Humanoid")
    if not hum then
        target.CFrame = destination
        return
    end
    local dist = (target.Position - destination.Position).Magnitude
    local tween = TweenService:Create(target, TweenInfo.new(dist / tweenSpeed, Enum.EasingStyle.Linear), {CFrame = destination})
    tween:Play()
    tween.Completed:Wait()
    target.CFrame = destination
end

local function moveCharacter(target, destination)
    movementIdx = movementIdx % 3 + 1
    if movementIdx == 1 then
        moveWalk(target, destination)
    elseif movementIdx == 2 then
        moveJump(target, destination)
    else
        moveTween(target, destination)
    end
end

-- Computer trigger ESP / auto-complete
local computerTriggers = {} -- original sizes stored

local function shrinkComputers()
    for _, obj in ipairs(workspace:GetDescendants()) do
        if obj:IsA("BasePart") and string.find(obj.Name, "ComputerTrigger") then
            obj.Size = Vector3.new(1, 1, 1)
        end
    end
end

local function restoreComputers()
    for trigger, size in pairs(computerTriggers) do
        if trigger and trigger.Parent then
            trigger.Size = size
        end
    end
    table.clear(computerTriggers)
end

local function shrinkActionSigns()
    table.clear(computerTriggers)
    for _, obj in ipairs(workspace:GetDescendants()) do
        if obj:IsA("BasePart") and not string.find(obj.Name, "ComputerTrigger") then
            if obj:FindFirstChild("ActionSign") then
                computerTriggers[obj] = obj.Size
                obj.Size = Vector3.new(0.1, 0.1, 0.1)
            end
        end
    end
end

local function isActionValid(trigger)
    local actionEvent = TempStats and TempStats:FindFirstChild("ActionEvent")
    local sign = trigger:FindFirstChild("ActionSign")
    if actionEvent and sign and sign:IsA("ValueBase") then
        local eventValue = actionEvent.Value
        local signValue = sign.Value
        return eventValue ~= nil and signValue ~= nil and (eventValue == signValue or eventValue == eventValue)
    end
    return false
end

local function waitForAction(trigger, timeout)
    local start = tick()
    while tick() - start < timeout do
        if isActionValid(trigger) then return true end
        task.wait()
    end
    return false
end

local function getActionProgress()
    local prog = TempStats and TempStats:FindFirstChild("ActionProgress")
    return prog and prog.Value or 0
end

local function performAction()
    task.wait(math.random(50, 150) / 1000)
    pcall(function() RemoteEvent:FireServer("Input", "Action", true) end)
    task.wait(math.random(40, 120) / 1000)
    pcall(function() RemoteEvent:FireServer("SetPlayerMinigameResult", true) end)
end

local function waitAndComplete(trigger)
    while autoHack do
        if getActionProgress() == 0 then
            task.wait(1.5)
            if getActionProgress() == 0 then
                shrinkComputers()
                break
            else
                performAction()
            end
        end
        task.wait(0.15)
    end
end

