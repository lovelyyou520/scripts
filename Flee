-- Teleport to Exit Door function
local function teleportToExitDoor()
    local char = Player.Character
    if not char or not char:FindFirstChild("HumanoidRootPart") then
        Library:Notify("Character not found!", 3)
        return
    end

    for _, obj in ipairs(workspace:GetDescendants()) do
        if obj:IsA("Script") and obj.Name == "ExitDoorScript" then
            local model = obj:FindFirstAncestorWhichIsA("Model")
            if model then
                local targetCFrame = model:GetPivot()
                char.HumanoidRootPart.CFrame = targetCFrame + Vector3.new(0, 3, 2)
                Library:Notify("Teleported to Exit Door!", 2)
                return
            end
        end
    end
    Library:Notify("Exit Door not found!", 3)
end

-- Highlight functions for ESP
local function highlightModel(model, color, name)
    if not model:FindFirstChild(name) then
        local hl = Instance.new("Highlight")
        hl.Name = name
        hl.Adornee = model
        hl.FillColor = color
        hl.OutlineColor = color
        hl.FillTransparency = 0.5
        hl.OutlineTransparency = 0
        hl.Parent = model
    end
end

local function clearHighlights(name)
    for _, obj in ipairs(workspace:GetDescendants()) do
        if obj:IsA("Highlight") and obj.Name == name then
            obj:Destroy()
        end
    end
end

local function highlightScriptObjects(scriptName, color, highlightName)
    while highlightName and (scriptName == "MainComputerScript" and highlightMainComputer
        or scriptName == "SingleDoorScript" and highlightSingleDoor
        or scriptName == "PodScript" and highlightPod
        or scriptName == "ExitDoorScript" and highlightExitDoor) do
        for _, obj in ipairs(workspace:GetDescendants()) do
            if obj:IsA("Script") and obj.Name == scriptName then
                local model = obj:FindFirstAncestorWhichIsA("Model")
                if model then
                    highlightModel(model, color, highlightName)
                end
            end
        end
        task.wait(2)
    end
    clearHighlights(highlightName)
end

