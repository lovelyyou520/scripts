-- Helper: check if a value is truthy
local function isTruthy(value)
    if not value then return false end
    if value:IsA("ValueBase") then
        local v = value.Value
        return v ~= nil and v ~= "" and v ~= false
    end
    return true
end

-- Auto-freeze logic
local function processFreezePods()
    for _, obj in ipairs(workspace:GetDescendants()) do
        if not autoFreeze then break end
        if obj.Name == "FreezePod" then
            local trigger = obj:FindFirstChild("PodTrigger")
            if trigger and trigger:IsA("BasePart") then
                if isTruthy(trigger:FindFirstChild("CapturedTorso")) then
                    if not freezePods[trigger] then
                        freezePods[trigger] = trigger.Size
                    end
                    trigger.Size = Vector3.new(2000, 2000, 2000)
                    if not frozenPods[trigger] then
                        frozenPods[trigger] = true
                        task.spawn(function()
                            while autoFreeze and trigger and trigger.Parent do
                                RemoteEvent:FireServer("Input", "Action", true)
                                task.wait()
                            end
                            if freezePods[trigger] and trigger and trigger.Parent then
                                trigger.Size = freezePods[trigger]
                            end
                            frozenPods[trigger] = nil
                        end)
                    end
                end
            end
        end
    end
end

local function clearFreezePods()
    table.clear(frozenPods)
    for trigger, size in pairs(freezePods) do
        if trigger and trigger.Parent then
            trigger.Size = size
        end
    end
    table.clear(freezePods)
end

local function autoFreezeLoop()
    task.spawn(function()
        while autoFreeze do
            processFreezePods()
            task.wait()
        end
    end)
end

