-- Keybind listener
UserInputService.InputBegan:Connect(function(input, gameProcessed)
    if gameProcessed then return end
    if UserInputService:GetFocusedTextBox() then return end
    local key = input.KeyCode
    if key == Enum.KeyCode.Unknown then return end

    -- Helper to toggle a Toggle object
    local function toggleOption(optionName)
        local toggle = Toggles[optionName]
        if toggle then
            toggle:SetValue(not toggle.Value)
        end
    end

    if Options.AutoHackKeybind and key == Options.AutoHackKeybind then
        toggleOption("AutoHackToggle")
    elseif Options.SpeedKeybind and key == Options.SpeedKeybind then
        toggleOption("SpeedToggle")
    elseif Options.NoclipKeybind and key == Options.NoclipKeybind then
        toggleOption("NoclipToggle")
    elseif Options.InvisibilityKeybind and key == Options.InvisibilityKeybind then
        toggleOption("InvisibleToggle")
    elseif Options.TeleportKeybind and key == Options.TeleportKeybind then
        teleportToExitDoor()
    elseif Options.AutoFreezeKeybind and key == Options.AutoFreezeKeybind then
        toggleOption("AutoFreezeToggle")
    elseif Options.FullBrightKeybind and key == Options.FullBrightKeybind then
        toggleOption("FullBrightToggle")
    elseif Options.ShittyGraphicsKeybind and key == Options.ShittyGraphicsKeybind then
        toggleOption("ShittyGraphicsToggle")
    elseif Options.FPSBoosterKeybind and key == Options.FPSBoosterKeybind then
        toggleOption("FPSBoosterToggle")
    elseif Options.SoldierESPKeybind and key == Options.SoldierESPKeybind then
        toggleOption("SoldierESP")
    end
end)

