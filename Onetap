-- Helper to fire Data changed listeners
local function fireDataChanged(key, value, oldValue)
    pcall(function()
        Data.changed_listeners:Fire("Set", {key}, value, oldValue)
    end)
end


local attributeMap = {
    primaryWeapon = "primaryWeapon",
    secondaryWeapon = "secondaryWeapon",
    currentKnife = "knifeName",
    killEffect = "killEffect",
    nametag = "nametag"
}


local function updateDataAndCharacter(key, value)
    local old = Data.Data[key]
    Data.Data[key] = value
    OT_Snapshot[key] = value
    fireDataChanged(key, value, old)

    local char = LocalPlayer.Character
    if char and attributeMap[key] then
        pcall(function() char:SetAttribute(attributeMap[key], value) end)
    end

    if char then
        local currentWeapon = char:GetAttribute("currentWeapon") or "Primary"
        local needsRefresh = false
        if key == "primaryWeapon" and currentWeapon == "Primary" then needsRefresh = true
        elseif key == "secondaryWeapon" and currentWeapon == "Secondary" then needsRefresh = true
        elseif key == "currentKnife" and currentWeapon == "Knife" then needsRefresh = true
        end
        if needsRefresh then
            pcall(function()
                ViewmodelClient.destroyCurrentWeapon()
                ViewmodelClient.startViewmodel(value, currentWeapon == "Knife" or nil)
            end)
        end
    end
end

-- Hook packet sends for equip actions to update snapshot
local equipPackets = {
    ["equipPrimary"] = "primaryWeapon",
    ["equipSecondary"] = "secondaryWeapon",
    ["equipKnife"] = "currentKnife"
}
for packetName, dataKey in pairs(equipPackets) do
    local packet = InventoryPackets[packetName]
    if packet and packet.send and not packet.__OT_hooked then
        local origSend = packet.send
        packet.send = function(value)
            pcall(origSend, value)
            updateDataAndCharacter(dataKey, value)
        end
        packet.__OT_hooked = true
    end
end

-- Silent aim (upvalue indices may need adjustment if the game updates)
local fireUpvalues = { pcall(debug.getupvalues, WeaponClient.fire, 1) }
if fireUpvalues[1] then
    local fireNetSend = fireUpvalues[2]
    if fireNetSend then
        local netSendUpvalues = { pcall(debug.getupvalues, fireNetSend, 14) }
        local netSend = netSendUpvalues[2]
        if netSend and type(netSend) == "table" and netSend.send then
            local origSend = netSend.send
            if not origSend.__OT_hooked then
                netSend.send = function(args)
                    if OT_cfg.silentAim and type(args) == "table" then
                        local bestTarget = nil
                        local bestDist = 900
                        for _, otherChar in ipairs(CollectionService:GetTagged("Character")) do
                            if otherChar ~= LocalPlayer.Character and otherChar:FindFirstChildOfClass("Humanoid") and otherChar.Humanoid.Health > 0 and otherChar:FindFirstChild("HumanoidRootPart") and not otherChar:FindFirstChild("ForceField") then
                                local part = otherChar:FindFirstChild("Head") or otherChar.HumanoidRootPart
                                local screenPos, onScreen = Camera:WorldToViewportPoint(part.Position)
                                if onScreen then
                                    local dist = (Vector2.new(screenPos.X, screenPos.Y) - Vector2.new(Camera.ViewportSize.X/2, Camera.ViewportSize.Y/2)).Magnitude
                                    if dist < bestDist then
                                        bestDist = dist
                                        bestTarget = otherChar
                                    end
                                end
                            end
                        end
                        if bestTarget then
                            local hitPart = bestTarget:FindFirstChild("Head") or bestTarget.HumanoidRootPart
                            local myHead = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("Head")
                            local origin = myHead and myHead.Position or args.origin
                            args.hitResult = true
                            args.hitPart = hitPart
                            args.position = hitPart.Position
                            args.origin = origin
                            args.direction = (hitPart.Position - origin).Unit
                            args.scoped = true
                            args.quickscope = true
                        end
                    end
                    return origSend(args)
                end
                origSend.__OT_hooked = true
            end
        end
    end
end

