-- Aimbot 
getgenv().OT_AimLoop = RunService.RenderStepped:Connect(function(deltaTime)
    if not OT_cfg.aimEnabled or not isAiming or not LocalPlayer.Character or not LocalPlayer.Character:FindFirstChild("HumanoidRootPart") then
        return
    end
    local myChar = LocalPlayer.Character
    local fov = OT_cfg.aimFov
    local center = Vector2.new(Camera.ViewportSize.X/2, Camera.ViewportSize.Y/2)
    local closestDist = fov
    local closestTarget = nil
    local closestPart = nil

    for _, otherChar in ipairs(CollectionService:GetTagged("Character")) do
        if otherChar ~= myChar and isValidTarget(otherChar) then
            local part = otherChar:FindFirstChild(OT_cfg.aimPart) or otherChar.HumanoidRootPart
            if part then
                local screenPos, onScreen = Camera:WorldToViewportPoint(part.Position)
                if onScreen then
                    local dist = (Vector2.new(screenPos.X, screenPos.Y) - center).Magnitude
                    if dist < closestDist then
                        if OT_cfg.aimWallCheck then
                            local params = RaycastParams.new()
                            params.FilterDescendantsInstances = {myChar, Camera:FindFirstChild("Viewmodel")}
                            params.FilterType = Enum.RaycastFilterType.Blacklist
                            local rayResult = workspace:Raycast(Camera.CFrame.Position, (part.Position - Camera.CFrame.Position).Unit * 1000, params)
                            if rayResult and rayResult.Instance:IsDescendantOf(otherChar) then
                                closestDist = dist
                                closestTarget = otherChar
                                closestPart = part
                            end
                        else
                            closestDist = dist
                            closestTarget = otherChar
                            closestPart = part
                        end
                    end
                end
            end
        end
    end

    if closestTarget then
        local targetPos = closestPart.Position
        local newCF = CFrame.new(Camera.CFrame.Position, targetPos)
        Camera.CFrame = Camera.CFrame:Lerp(newCF, math.clamp(OT_cfg.aimSmooth / 100 * deltaTime * 60, 0, 1))
    end
end)

-- ESP and Chams management
local espObjects = {}
local chamObjects = {}
local hitboxExpanded = {}  -- stores { originalSize, indicator }

local function removeESP(char)
    local obj = espObjects[char]
    if obj then
        pcall(function() obj.hi:Destroy() end)
        pcall(function() obj.bb:Destroy() end)
        espObjects[char] = nil
    end
end

local function removeChams(char)
    local obj = chamObjects[char]
    if obj then
        pcall(function() obj:Destroy() end)
        chamObjects[char] = nil
    end
end

local lastESPUpdate = 0
getgenv().OT_ESPLoop = RunService.Heartbeat:Connect(function()
    if tick() < lastESPUpdate then return end
    lastESPUpdate = tick() + 0.12

    if not OT_cfg.espEnabled and not OT_cfg.chams and not OT_cfg.hitboxExpand then return end
    local myChar = LocalPlayer.Character
    if not myChar then return end

    local seenChars = {}
    local characters = CollectionService:GetTagged("Character")
    for _, char in ipairs(characters) do
        -- FIXED: removed "and not Players:GetPlayerFromCharacter(char)" to enable ESP on all characters (players + NPCs)
        if char ~= myChar and isValidTarget(char) then
            seenChars[char] = true
            local player = Players:GetPlayerFromCharacter(char)

            -- ESP (Highlight + Billboard)
            if OT_cfg.espEnabled then
                if not espObjects[char] then
                    local highlight = Instance.new("Highlight")
                    highlight.Name = "OT_ESP"
                    highlight.FillTransparency = 0.7
                    highlight.OutlineTransparency = 0
                    -- Player: green, Bot: orange
                    highlight.FillColor = player and Color3.fromRGB(60, 255, 60) or Color3.fromRGB(255, 180, 60)
                    highlight.OutlineColor = Color3.new(1, 1, 1)
                    highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
                    highlight.Parent = char

                    local billboard = Instance.new("BillboardGui")
                    billboard.Size = UDim2.new(0, 180, 0, 30)
                    billboard.StudsOffset = Vector3.new(0, 3, 0)
                    billboard.AlwaysOnTop = true
                    billboard.Parent = char

                    local label = Instance.new("TextLabel")
                    label.BackgroundTransparency = 1
                    label.Size = UDim2.new(1, 0, 1, 0)
                    label.TextColor3 = Color3.new(1, 1, 1)
                    label.Font = Enum.Font.GothamBold
                    label.TextSize = 13
                    label.TextStrokeTransparency = 0
                    label.Parent = billboard

                    espObjects[char] = {hi = highlight, bb = billboard, lbl = label}
                end
                -- Build ESP text
                local info = {}
                if player then
                    if OT_cfg.espName then table.insert(info, player.Name) end
                    if OT_cfg.espHealth then
                        local hum = char:FindFirstChildOfClass("Humanoid")
                        if hum then
                            table.insert(info, string.format("[%d]", math.ceil(hum.Health)))
                        end
                    end
                else
                    table.insert(info, char.Name .. " [BOT]")
                end
                if OT_cfg.espDistance then
                    local hrp = char:FindFirstChild("HumanoidRootPart")
                    if hrp then
                        local dist = (hrp.Position - Camera.CFrame.Position).Magnitude
                        table.insert(info, string.format("%dm", dist))
                    end
                end
                espObjects[char].lbl.Text = table.concat(info, "  ")
            end

            -- Chams
            if OT_cfg.chams then
                if not chamObjects[char] then
                    local highlight = Instance.new("Highlight")
                    highlight.FillTransparency = 0.25
                    highlight.OutlineTransparency = 0
                    highlight.FillColor = player and Color3.fromRGB(60, 255, 60) or Color3.fromRGB(255, 150, 0)
                    highlight.OutlineColor = Color3.fromRGB(0, 0, 0)
                    highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
                    highlight.Parent = char
                    chamObjects[char] = highlight
                end
            end

            -- Hitbox expander (now works on all characters)
            if OT_cfg.hitboxExpand then
                local head = char:FindFirstChild("Head")
                if head and head:IsA("BasePart") then
                    if not hitboxExpanded[head] then
                        hitboxExpanded[head] = {
                            originalSize = head.Size,
                            indicator = nil
                        }
                    end
                    local data = hitboxExpanded[head]
                    head.Size = data.originalSize * OT_cfg.hitboxExpandMultiplier

                    if not data.indicator then
                        local sphere = Instance.new("Part")
                        sphere.Name = "OT_HitboxIndicator"
                        sphere.Shape = Enum.PartType.Ball
                        sphere.Anchored = true
                        sphere.CanCollide = false
                        sphere.Transparency = 0.5
                        sphere.Color = Color3.new(1, 1, 1)
                        sphere.Material = Enum.Material.SmoothPlastic
                        sphere.Parent = head
                        data.indicator = sphere
                    end
                    data.indicator.Size = head.Size
                end
            end
        end
    end

    -- Remove ESP/Chams for characters no longer seen
    for char, _ in pairs(espObjects) do
        if not seenChars[char] then
            removeESP(char)
        end
    end
    for char, _ in pairs(chamObjects) do
        if not seenChars[char] then
            removeChams(char)
        end
    end
    -- Restore hitbox sizes and destroy indicators for non‑seen heads
    for head, data in pairs(hitboxExpanded) do
        if not seenChars[head.Parent] then
            pcall(function()
                head.Size = data.originalSize
                if data.indicator then data.indicator:Destroy() end
            end)
            hitboxExpanded[head] = nil
        end
    end
end)

-- Triggerbot
local lastTrigger = 0
getgenv().OT_TriggerLoop = RunService.Heartbeat:Connect(function()
    if not OT_cfg.triggerbot then return end
    local char = LocalPlayer.Character
    if not char or not char:GetAttribute("deployed") or not isValidTarget(char) then return end
    if tick() - lastTrigger < 0.1 then return end

    local ignore = {char}
    local viewmodel = Camera:FindFirstChild("Viewmodel")
    if viewmodel then table.insert(ignore, viewmodel) end

    local rayParams = RaycastParams.new()
    rayParams.FilterDescendantsInstances = ignore
    rayParams.FilterType = Enum.RaycastFilterType.Blacklist

    local rayResult = workspace:Raycast(Camera.CFrame.Position, Camera.CFrame.LookVector * 800, rayParams)
    if not rayResult then return end

    local hitInstance = rayResult.Instance
    local targetModel = hitInstance:FindFirstAncestorOfClass("Model")
    if targetModel and isValidTarget(targetModel) and CollectionService:HasTag(targetModel, "Character") then
        lastTrigger = tick()
        pcall(WeaponClient.fire)
    end
end)

