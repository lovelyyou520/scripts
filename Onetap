-- Function to update stats and notify
local function updateStat(key, value)
    local old = Data.Data[key]
    Data.Data[key] = value
    fireDataChanged(key, value, old)
end

-- Pinned stats (persistent over server sync)
getgenv().OT_Pinned = getgenv().OT_Pinned or {}

-- Auto-reinject loop (checks if items lost, re-inject)
getgenv().OT_Housekeep = task.spawn(function()
    while true do
        task.wait(1)
        -- Re-apply pinned stats
        for key, value in pairs(getgenv().OT_Pinned) do
            if Data.Data[key] ~= value then
                updateStat(key, value)
            end
        end
        -- Auto deploy
        if OT_cfg.autoDeploy then
            local char = LocalPlayer.Character
            if char and not char:GetAttribute("deployed") then
                pcall(function() MainGamePackets.deploy.send() end)
            end
        end
        -- Auto vote
        if OT_cfg.autoVote then
            local state = workspace:GetAttribute("gameState")
            if state and state ~= "game" then
                pcall(function() MainGamePackets.voteMap.send(math.random(1, 3)) end)
                pcall(function() MainGamePackets.voteGamemode.send(math.random(1, 3)) end)
            end
        end
        -- Auto re-inject items if lost
        if OT_cfg.autoReinject and getgenv().OT_UnlockedTotal then
            local currentCount = #Data.Data.primaries + #Data.Data.secondaries + #Data.Data.knives + #Data.Data.killEffects + #Data.Data.nametags
            if currentCount < getgenv().OT_UnlockedTotal - 5 then
                -- Re-unlock all
                local function contains(t, v)
                    for _, item in ipairs(t) do if item == v then return true end end
                    return false
                end
                -- Unlock weapons
                for name, data in pairs(WeaponManager.getWeapons()) do
                    local list = type(data) == "table" and data.isPistol and Data.Data.secondaries or Data.Data.primaries
                    if not contains(list, name) then
                        table.insert(list, name)
                    end
                end
                -- Unlock knives
                for _, knife in ipairs(WeaponManager.getKnives()) do
                    if not contains(Data.Data.knives, knife) then
                        table.insert(Data.Data.knives, knife)
                    end
                end
                -- Unlock kill effects
                if KillEffectManager.getKillEffects then
                    for _, effect in ipairs(KillEffectManager.getKillEffects()) do
                        if not contains(Data.Data.killEffects, effect) then
                            table.insert(Data.Data.killEffects, effect)
                        end
                    end
                end
                -- Unlock nametags
                if NametagManager.getNametags then
                    for _, tag in ipairs(NametagManager.getNametags()) do
                        if not contains(Data.Data.nametags, tag) then
                            table.insert(Data.Data.nametags, tag)
                        end
                    end
                end
            end
        end
    end
end)

