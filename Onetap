local StatsGroup = Tabs.Stats:AddLeftGroupbox("Modify Currency (Local)", "chart-simple")
StatsGroup:AddLabel("Visual only. Changes will not save to your account.")
local function createStatInput(name, dataKey)
    StatsGroup:AddInput(name .. "Input", {
        Default = tostring(Data.Data[dataKey] or 0),
        Numeric = true,
        Finished = false,
        Text = name,
        Tooltip = "Press Enter to apply",
        Placeholder = tostring(Data.Data[dataKey] or 0),
        Callback = function(text)
            local num = tonumber(text)
            if not num then return end
            updateStat(dataKey, num)
            getgenv().OT_Pinned[dataKey] = num
            Library:Notify(string.format("Spoofed %s to %d", name, num), 2)
        end
    })
end
