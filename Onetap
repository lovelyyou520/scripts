-- Helper to check if character is valid (alive, no forcefield)
local function isValidTarget(char)
    if not char then return false end
    local hum = char:FindFirstChildOfClass("Humanoid")
    return hum and hum.Health > 0 and char:FindFirstChild("HumanoidRootPart") and not char:FindFirstChild("ForceField")
end

