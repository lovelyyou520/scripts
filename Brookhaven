    if v then startFlight() else stopFlight() end
end })
MovementGroup:AddSlider("FlySpeed", { Text = "Fly Speed", Default = 50, Min = 1, Max = 1000, Rounding = 0, Callback = function(v) 
    flightSpeed = v
end })

