-- Vehicle Speed Logic
local vehicleSpeedEnabled = false
local vehicleSpeedValue = 100
local lastSeat = nil

MovementGroup:AddToggle("VehicleSpeedToggle", { Text = "Enable Vehicle Speed", Default = false, Callback = function(v) 
    vehicleSpeedEnabled = v
end })
MovementGroup:AddSlider("VehicleSpeedSlider", { Text = "Vehicle Speed", Default = 100, Min = 1, Max = 1000, Rounding = 0, Callback = function(v) 
    vehicleSpeedValue = v
end })

RunService.RenderStepped:Connect(function()
    if vehicleSpeedEnabled and LP.Character then
        local humanoid = LP.Character:FindFirstChildOfClass("Humanoid")
        if humanoid and humanoid.SeatPart and humanoid.SeatPart:IsA("VehicleSeat") then
            local seat = humanoid.SeatPart
            lastSeat = seat
            seat.MaxSpeed = vehicleSpeedValue
            seat.Torque = 9e9
            
            local raycastParams = RaycastParams.new()
            raycastParams.FilterDescendantsInstances = {seat.Parent, LP.Character}
            raycastParams.FilterType = Enum.RaycastFilterType.Exclude
            
            local result = Workspace:Raycast(seat.Position, Vector3.new(0, -20, 0), raycastParams)
            local yVel = 0
            if result then
                -- Target ~4.5 studs above ground (roughly 1 stud clearance for most cars)
                local targetY = result.Position.Y + 4.5
                yVel = (targetY - seat.Position.Y) * 10
            end
            
            local flatLook = Vector3.new(seat.CFrame.LookVector.X, 0, seat.CFrame.LookVector.Z)
            if flatLook.Magnitude > 0 then
                flatLook = flatLook.Unit
            end
            
            if seat.Throttle == 1 then
                seat.AssemblyLinearVelocity = Vector3.new((flatLook * vehicleSpeedValue).X, yVel, (flatLook * vehicleSpeedValue).Z)
            elseif seat.Throttle == -1 then
                seat.AssemblyLinearVelocity = Vector3.new((flatLook * -vehicleSpeedValue).X, yVel, (flatLook * -vehicleSpeedValue).Z)
            else
                seat.AssemblyLinearVelocity = Vector3.new(seat.AssemblyLinearVelocity.X * 0.9, yVel, seat.AssemblyLinearVelocity.Z * 0.9)
            end
            
            local bg = seat:FindFirstChild("VehicleFlyGyro")
            if not bg then
                bg = Instance.new("BodyGyro")
                bg.Name = "VehicleFlyGyro"
                bg.maxTorque = Vector3.new(9e9, 0, 9e9) -- Keeps car flat (Pitch & Roll), allows normal steering (Yaw)
                bg.P = 3000
                bg.D = 500
                bg.Parent = seat
            end
            bg.cframe = CFrame.new(seat.Position)
        else
            if lastSeat then
                local bg = lastSeat:FindFirstChild("VehicleFlyGyro")
                if bg then bg:Destroy() end
                lastSeat = nil
            end
        end
    else
        if lastSeat then
            local bg = lastSeat:FindFirstChild("VehicleFlyGyro")
            if bg then bg:Destroy() end
            lastSeat = nil
        end
    end
end)

