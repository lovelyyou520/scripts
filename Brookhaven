end)

-- Float Logic
local floatEnabled = false

local function stopFloat()
    floatEnabled = false
    local char = LP.Character
    if char then
        local humanoid = char:FindFirstChildOfClass("Humanoid")
        local hrp = char:FindFirstChild("HumanoidRootPart")
        if humanoid then humanoid.PlatformStand = false end
        if hrp then
            local bv = hrp:FindFirstChild("FloatVelocity")
            local bg = hrp:FindFirstChild("FloatGyro")
            if bv then bv:Destroy() end
            if bg then bg:Destroy() end
        end
    end
end

local function startFloat()
    local char = LP.Character
    if not char then return end
    local humanoid = char:FindFirstChildOfClass("Humanoid")
    local hrp = char:FindFirstChild("HumanoidRootPart")
    if not humanoid or not hrp then return end
    
    stopFloat()
    floatEnabled = true
    
    humanoid.PlatformStand = true
    
    local bg = Instance.new("BodyGyro")
    bg.Name = "FloatGyro"
    bg.maxTorque = Vector3.new(9e9, 9e9, 9e9)
    bg.cframe = hrp.CFrame
    bg.Parent = hrp
    
    local bv = Instance.new("BodyVelocity")
    bv.Name = "FloatVelocity"
    bv.maxForce = Vector3.new(9e9, 9e9, 9e9)
    bv.velocity = Vector3.new(0, 0, 0)
    bv.Parent = hrp
    
    local camera = Workspace.CurrentCamera
    
    task.spawn(function()
        while floatEnabled and hrp and bv and bg do
            local movement = Vector3.new(0, 0, 0)
            
            if UserInputService:IsKeyDown(Enum.KeyCode.W) then movement = movement + camera.CFrame.LookVector end
            if UserInputService:IsKeyDown(Enum.KeyCode.S) then movement = movement - camera.CFrame.LookVector end
            if UserInputService:IsKeyDown(Enum.KeyCode.A) then movement = movement - camera.CFrame.RightVector end
            if UserInputService:IsKeyDown(Enum.KeyCode.D) then movement = movement + camera.CFrame.RightVector end
            
            -- Only horizontal movement, no vertical movement for Float except Y maintain
            movement = Vector3.new(movement.X, 0, movement.Z)
            
            if humanoid.MoveDirection.Magnitude > 0 then
                local joystickDir = humanoid.MoveDirection
                local lookVector = camera.CFrame.LookVector
                local joyMove = lookVector * (joystickDir.Magnitude)
                movement = Vector3.new(joyMove.X, 0, joyMove.Z)
            end
            
            local yVelocity = 0
            if UserInputService:IsKeyDown(Enum.KeyCode.Space) then
                yVelocity = 25
            elseif UserInputService:IsKeyDown(Enum.KeyCode.LeftControl) or UserInputService:IsKeyDown(Enum.KeyCode.LeftShift) then
                yVelocity = -25
            end
            
            if movement.Magnitude > 0 then
                bv.velocity = (movement.Unit * flightSpeed) + Vector3.new(0, yVelocity, 0)
            else
                bv.velocity = Vector3.new(0, yVelocity, 0)
            end
            
            -- Keep character upright
            bg.cframe = CFrame.new(hrp.Position, hrp.Position + movement)
            if movement.Magnitude == 0 then
                bg.cframe = hrp.CFrame
            end
            
            RunService.RenderStepped:Wait()
        end
    end)
end

