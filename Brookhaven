UtilityGroup:AddButton("Copy Avatar", function()
    if avatarSelectedPlayerName then
        local targetPlayer = Players:FindFirstChild(avatarSelectedPlayerName)
        if targetPlayer and targetPlayer.Character then
            local myChar = LP.Character
            local targetChar = targetPlayer.Character
            
            if myChar and targetChar then
                local myHum = myChar:FindFirstChildOfClass("Humanoid")
                local targetHum = targetChar:FindFirstChildOfClass("Humanoid")
                
                if myHum and targetHum then
                    -- 1. Apply their exact in-game humanoid description (handles scaling and base packages)
                    local success, desc = pcall(function()
                        return targetHum:GetAppliedDescription()
                    end)
                    if success and desc then
                        myHum:ApplyDescription(desc)
                    end
                end
                
                -- 2. Manually copy visual items to ensure custom/game-specific accessories and clothes are copied perfectly
                for _, v in pairs(myChar:GetChildren()) do
                    if v:IsA("Accessory") or v:IsA("Shirt") or v:IsA("Pants") or v:IsA("ShirtGraphic") or v:IsA("CharacterMesh") or v:IsA("BodyColors") then
                        v:Destroy()
                    end
                end
                
                for _, v in pairs(targetChar:GetChildren()) do
                    if v:IsA("Accessory") or v:IsA("Shirt") or v:IsA("Pants") or v:IsA("ShirtGraphic") or v:IsA("CharacterMesh") or v:IsA("BodyColors") then
                        local clone = v:Clone()
                        if clone then clone.Parent = myChar end
                    end
                end
                
                local myHead = myChar:FindFirstChild("Head")
                local targetHead = targetChar:FindFirstChild("Head")
                if myHead and targetHead then
                    for _, v in pairs(myHead:GetChildren()) do
                        if v:IsA("Decal") or v:IsA("Texture") then v:Destroy() end
                    end
                    for _, v in pairs(targetHead:GetChildren()) do
                        if v:IsA("Decal") or v:IsA("Texture") then 
                            local clone = v:Clone()
                            if clone then clone.Parent = myHead end
                        end
                    end
                end
            end
        end
    end
end)

