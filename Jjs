local lockOnEnabled = false
local orbitRadius = 8
local orbitSpeed = 12
local orbitAngle = 0
local lockTarget = nil
local orbitConnection = nil

local function GetNearestPlayer()
    local _, hrp = GetChar()
    if not hrp then return nil end
    local closest, dist = nil, math.huge
    for _, p in ipairs(game.Players:GetPlayers()) do
        if p ~= LocalPlayer and p.Character then
            local ehrp = p.Character:FindFirstChild("HumanoidRootPart")
            local ehum = p.Character:FindFirstChildOfClass("Humanoid")
            if ehrp and ehum and ehum.Health > 0 then
                local d = (ehrp.Position - hrp.Position).Magnitude
                if d < dist then dist = d; closest = p end
            end
        end
    end
    return closest
end

local function StartOrbit()
    if orbitConnection then return end
    orbitConnection = game:GetService("RunService").RenderStepped:Connect(function(dt)
        if not lockOnEnabled then return end

        local _, hrp, hum = GetChar()
        if not hrp or not hum then return end

        if not lockTarget or not lockTarget.Character or not lockTarget.Character:FindFirstChild("HumanoidRootPart") then
            lockTarget = GetNearestPlayer()
        end
        if not lockTarget then return end

        local targetHRP = lockTarget.Character:FindFirstChild("HumanoidRootPart")
        local targetHum = lockTarget.Character:FindFirstChildOfClass("Humanoid")
        if not targetHRP or not targetHum or targetHum.Health <= 0 then
            lockTarget = nil
            return
        end

        orbitAngle = orbitAngle + (orbitSpeed * dt * 2 * math.pi)
        if orbitAngle > 2 * math.pi then orbitAngle = orbitAngle - 2 * math.pi end

        local targetPos = targetHRP.Position
        local orbitPos = targetPos + Vector3.new(
            math.cos(orbitAngle) * orbitRadius,
            2,
            math.sin(orbitAngle) * orbitRadius
        )

        local lookAt = CFrame.lookAt(orbitPos, targetPos)
        hrp.CFrame = lookAt
        hrp.Velocity = Vector3.zero
        hrp.AssemblyLinearVelocity = Vector3.zero
    end)
end

local function StopOrbit()
    if orbitConnection then
        orbitConnection:Disconnect()
        orbitConnection = nil
    end
    lockTarget = nil
end

