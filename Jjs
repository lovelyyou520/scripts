local espEnabled = false
local espObjects = {}
local espConnection = nil

local function UpdateESP()
    for _, obj in pairs(espObjects) do
        if obj then pcall(function() obj:Destroy() end) end
    end
    espObjects = {}

    if not espEnabled then return end

    -- Temporary theme colors since ThemeManager doesn't expose them exactly like SnowyLib
    local C_accent = Color3.fromRGB(0, 170, 255)
    local C_on = Color3.fromRGB(0, 255, 0)
    local C_orange = Color3.fromRGB(255, 170, 0)
    local C_red = Color3.fromRGB(255, 0, 0)

    for _, p in ipairs(game.Players:GetPlayers()) do
        if p ~= LocalPlayer and p.Character then
            local head = p.Character:FindFirstChild("Head")
            local hum = p.Character:FindFirstChildOfClass("Humanoid")
            if head and hum then
                local bill = Instance.new("BillboardGui")
                bill.Name = "SnowyJJS_ESP"
                bill.Adornee = head
                bill.Size = UDim2.new(0, 200, 0, 50)
                bill.StudsOffset = Vector3.new(0, 3, 0)
                bill.AlwaysOnTop = true
                bill.Parent = head

                local name = Instance.new("TextLabel", bill)
                name.Size = UDim2.new(1, 0, 0.5, 0)
                name.BackgroundTransparency = 1
                name.Text = p.DisplayName
                name.TextColor3 = C_accent
                name.TextSize = 14
                name.Font = Enum.Font.GothamBold
                name.TextStrokeTransparency = 0.3

                local info = Instance.new("TextLabel", bill)
                info.Size = UDim2.new(1, 0, 0.5, 0)
                info.Position = UDim2.new(0, 0, 0.5, 0)
                info.BackgroundTransparency = 1
                info.TextColor3 = hum.Health > 50 and C_on or (hum.Health > 25 and C_orange or C_red)
                info.TextSize = 11
                info.Font = Enum.Font.GothamMedium
                info.TextStrokeTransparency = 0.3

                task.spawn(function()
                    while espEnabled and bill and bill.Parent do
                        local _, hrp = GetChar()
                        local ehrp = p.Character and p.Character:FindFirstChild("HumanoidRootPart")
                        local eh = p.Character and p.Character:FindFirstChildOfClass("Humanoid")
                        if hrp and ehrp and eh then
                            local dist = math.floor((hrp.Position - ehrp.Position).Magnitude)
                            info.Text = string.format("HP: %d/%d | %dm", math.floor(eh.Health), math.floor(eh.MaxHealth), dist)
                            info.TextColor3 = eh.Health > 50 and C_on or (eh.Health > 25 and C_orange or C_red)
                        end
                        task.wait(0.25)
                    end
                end)

                table.insert(espObjects, bill)
            end
        end
    end
end

local function StartESP()
    espEnabled = true
    UpdateESP()
    if not espConnection then
        espConnection = {}
        table.insert(espConnection, game.Players.PlayerAdded:Connect(function()
            if espEnabled then task.wait(2) UpdateESP() end
        end))
        table.insert(espConnection, game.Players.PlayerRemoving:Connect(function()
            if espEnabled then task.wait(0.5) UpdateESP() end
        end))
    end
end

local function StopESP()
    espEnabled = false
    if espConnection then
        for _, conn in ipairs(espConnection) do conn:Disconnect() end
        espConnection = nil
    end
    for _, obj in pairs(espObjects) do
        if obj then pcall(function() obj:Destroy() end) end
    end
    espObjects = {}
end

