local Utility, OldRaycast

local function getClosestTarget()
    local cam = workspace.CurrentCamera
    if not cam then return nil end
    local center = Vector2.new(cam.ViewportSize.X / 2, cam.ViewportSize.Y / 2)
    local closest, closestDist = nil, SilentCfg.FOVRadius

    for _, entity in CollectionService:GetTagged("Entity") do
        if entity == LocalPlayer.Character then continue end
        local part = entity:FindFirstChild(SilentCfg.HitPart, true)
        if not part or not part:IsA("BasePart") then continue end

        local screenPos, onScreen = cam:WorldToViewportPoint(part.Position)
        if not onScreen then continue end

        local dist = (center - Vector2.new(screenPos.X, screenPos.Y)).Magnitude
        if dist < closestDist then
            closestDist = dist
            closest = part
        end
    end
    return closest
end

Toggles.SilentAim:OnChanged(function()
    local enabled = Toggles.SilentAim.Value
    if enabled then
        if not Utility then
            local ok, util = pcall(function()
                return require(ReplicatedStorage.Modules.Utility)
            end)
            if not ok then
                Library:Notify("Utility module missing", 3)
                Toggles.SilentAim:SetValue(false)
                return
            end
            Utility = util
            OldRaycast = Utility.Raycast
        end

        Utility.Raycast = function(self, origin, direction, maxDist, ...)
            if type(maxDist) ~= "number" or maxDist < 100 then
                return OldRaycast(self, origin, direction, maxDist, ...)
            end
            local target = getClosestTarget()
            if not target then
                return OldRaycast(self, origin, direction, maxDist, ...)
            end
            local pos = target.Position
            local dir = (pos - origin).Unit
            local dist = (pos - origin).Magnitude
            if dist > maxDist then
                dist = maxDist
                pos = origin + dir * maxDist
            end
            return {
                Position = pos,
                Distance = dist,
                Instance = target,
                Material = target.Material,
                Normal = -dir,
            }
        end
    else
        if Utility and OldRaycast then
            Utility.Raycast = OldRaycast
        end
    end
end)

local DesyncController = { active = false }

function DesyncController:Shutdown()
    self.active = false
    if self.conn1 then pcall(function() self.conn1:Disconnect() end) end
    if self.conn2 then pcall(function() self.conn2:Disconnect() end) end
    if self.task1 then pcall(function() task.cancel(self.task1) end) end
    if self.oldfunc and self.GunModule then
        pcall(function() self.GunModule.StartShooting = self.oldfunc end)
    end
end

function DesyncController:Init()
    self:Shutdown()
    self.active = true
    self.target = nil
    self.desync = false

    local ok, gun = pcall(function()
        return require(LocalPlayer.PlayerScripts.Modules.ItemTypes.Gun)
    end)
    if not ok then
        Library:Notify("Gun module missing", 3)
        return
    end
    self.GunModule = gun

    local ok2, util = pcall(function()
        return require(ReplicatedStorage.Modules.Utility)
    end)
    if not ok2 then
        Library:Notify("Utility module missing", 3)
        return
    end
    self.UtilityMod = util

    self.conn1 = RunService.Heartbeat:Connect(function()
        if not self.active then return end
        self.target = self:FindClosest()
    end)

    self.oldfunc = self.GunModule.StartShooting
    local controller = self

    self.GunModule.StartShooting = function(selfGun, ...)
        local results = {controller.oldfunc(selfGun, ...)}
        if not selfGun.ClientFighter or not selfGun.ClientFighter.IsLocalPlayer then
            return unpack(results)
        end
        local data = results[3]
        if not data or typeof(data) ~= "table" then
            return unpack(results)
        end
        results[4] = true
        local tgt = controller.target
        if not controller.active or not tgt or not tgt.Character then
            return unpack(results)
        end
        if not controller.desync or controller.curr ~= tgt then
            controller:DesyncStart(tgt)
            task.wait(0.1)
        end
        if controller.task1 then
            pcall(function() task.cancel(controller.task1) end)
            controller.task1 = nil
        end
        local head = tgt.Character:FindFirstChild("Head")
        if not head then return unpack(results) end
        local headPos = head.Position
        local under = headPos - Vector3.new(0, 5, 0)
        local look = CFrame.lookAt(under, headPos)
        local randCF = head.CFrame:ToObjectSpace(CFrame.new(headPos + Vector3.new(math.random(), math.random(), math.random())))
        data[utf8.char(0)] = controller.UtilityMod:EncodeCFrame(CFrame.new(under, headPos) * CFrame.Angles(look:ToOrientation()))
        data[utf8.char(1)] = controller.UtilityMod:EncodeCFrame(CFrame.new(headPos) * CFrame.Angles(look:ToOrientation()))
        data[utf8.char(2)] = head
        data[utf8.char(3)] = controller.UtilityMod:EncodeCFrame(randCF)
        controller.task1 = task.delay(0.15, function()
            controller:DesyncStop()
        end)
        return unpack(results)
    end
end

function DesyncController:FindClosest()
    local myChar = LocalPlayer.Character
    if not myChar then return nil end
    local myRoot = myChar:FindFirstChild("HumanoidRootPart")
    if not myRoot then return nil end
    local closest, closestDist = nil, 200
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr == LocalPlayer then continue end
        if plr:GetAttribute("TeamID") == LocalPlayer:GetAttribute("TeamID") then continue end
        local char = plr.Character
        if not char then continue end
        local root = char:FindFirstChild("HumanoidRootPart")
        local head = char:FindFirstChild("Head")
        local hum = char:FindFirstChildWhichIsA("Humanoid")
        if not (root and head and hum and hum.Health > 0) then continue end
        local dist = (myRoot.Position - root.Position).Magnitude
        if dist < closestDist then
            closestDist = dist
            closest = plr
        end
    end
    return closest
end

function DesyncController:DesyncStart(target)
    if self.conn2 then pcall(function() self.conn2:Disconnect() end) end
    self.desync = true
    self.curr = target
    self.conn2 = RunService.Heartbeat:Connect(function()
        if not self.desync then return end
        local char = LocalPlayer.Character
        local root = char and char:FindFirstChild("HumanoidRootPart")
        if not root then return end
        local tRoot = target.Character and target.Character:FindFirstChild("HumanoidRootPart")
        if not tRoot then
            self:DesyncStop()
            return
        end
        local oldCF = root.CFrame
        local oldVel = root.Velocity
        local oldRot = root.RotVelocity
        root.CFrame = tRoot.CFrame * CFrame.new(0, -5, 0)
        RunService:BindToRenderStep("__restore", 101, function()
            root.CFrame = oldCF
            root.Velocity = oldVel
            root.RotVelocity = oldRot
            RunService:UnbindFromRenderStep("__restore")
        end)
    end)
end

function DesyncController:DesyncStop()
    self.desync = false
    self.curr = nil
    if self.conn2 then
        pcall(function() self.conn2:Disconnect() end)
        self.conn2 = nil
    end
end

