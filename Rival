local function spoofTitleLabelsInContainer(container)
    if not container then return end
    for _, playerFrame in ipairs(container:GetChildren()) do
        if playerFrame:IsA("Frame") then
            local spoofed = false
            local inner = playerFrame:FindFirstChild("Container")
            if inner and inner:IsA("Frame") then
                for _, child in ipairs(inner:GetChildren()) do
                    if child:IsA("Frame") then
                        local title = child:FindFirstChild("Title")
                        if title and title:IsA("TextLabel") then
                            local isLocal = title.Text == LocalPlayer.Name or title.Text == LocalPlayer.DisplayName
                            title.Text = isLocal and SpoofCfg.your_spoofed_name or SpoofCfg.spoofed_enemy_names
                            spoofed = true
                        end
                    end
                end
            end
            if not spoofed then
                for _, title in ipairs(findAllTitleLabels(playerFrame)) do
                    local isLocal = title.Text == LocalPlayer.Name or title.Text == LocalPlayer.DisplayName
                    title.Text = isLocal and SpoofCfg.your_spoofed_name or SpoofCfg.spoofed_enemy_names
                end
            end
        end
    end
end

