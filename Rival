local ESPObjects = {}

local function removeESP(player)
    local data = ESPObjects[player]
    if not data then return end
    for _, obj in pairs(data) do
        if obj then pcall(function() obj:Remove() end) end
    end
    ESPObjects[player] = nil
end

local function createESP(player)
    if ESPObjects[player] then return end
    ESPObjects[player] = {
        Box    = SafeDrawing("Square", {Visible = false, Thickness = 1, Filled = false, ZIndex = 1}),
        Name   = SafeDrawing("Text", {Visible = false, Center = true, Outline = true, Size = 14, Font = 2, ZIndex = 2}),
        Health = SafeDrawing("Line", {Visible = false, Thickness = 2, ZIndex = 2}),
        Tracer = SafeDrawing("Line", {Visible = false, Thickness = 1, ZIndex = 1}),
        Dist   = SafeDrawing("Text", {Visible = false, Center = true, Outline = true, Size = 12, Font = 2, ZIndex = 2}),
    }
end

local function isTeammate(player)
    if not ESPCfg.TeamCheck then return false end
    local myTeam = LocalPlayer:GetAttribute("TeamID")
    local theirTeam = player:GetAttribute("TeamID")
    if myTeam and theirTeam then return myTeam == theirTeam end
    if LocalPlayer.Team and player.Team then return LocalPlayer.Team == player.Team end
    return false
end

local function updateESP()
    if not ESPCfg.Enabled then
        for plr in pairs(ESPObjects) do removeESP(plr) end
        return
    end
    local cam = workspace.CurrentCamera
    if not cam then return end
    local myRoot = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")

    for _, player in ipairs(Players:GetPlayers()) do
        if player == LocalPlayer or isTeammate(player) then
            removeESP(player)
            continue
        end
        local char = player.Character
        local hum = char and char:FindFirstChildWhichIsA("Humanoid")
        local root = char and char:FindFirstChild("HumanoidRootPart")
        local head = char and char:FindFirstChild("Head")
        if not (hum and root and hum.Health > 0) then
            removeESP(player)
            continue
        end
        local dist = myRoot and (myRoot.Position - root.Position).Magnitude or 0
        if dist > ESPCfg.MaxDistance then
            removeESP(player)
            continue
        end
        createESP(player)
        local data = ESPObjects[player]
        if not data then continue end

        local topPos = (head and head.Position + Vector3.new(0, 0.8, 0)) or (root.Position + Vector3.new(0, 2.5, 0))
        local bottomPos = root.Position - Vector3.new(0, 3, 0)
        local top, topVis = cam:WorldToViewportPoint(topPos)
        local bottom, bottomVis = cam:WorldToViewportPoint(bottomPos)

        if not (topVis or bottomVis) then
            data.Box.Visible = false
            data.Name.Visible = false
            data.Health.Visible = false
            data.Tracer.Visible = false
            data.Dist.Visible = false
            continue
        end

        local height = math.abs(top.Y - bottom.Y)
        local width = height / 2
        local boxX = top.X - width / 2
        local boxY = top.Y

        if ESPCfg.Boxes and data.Box then
            data.Box.Size = Vector2.new(width, height)
            data.Box.Position = Vector2.new(boxX, boxY)
            data.Box.Color = ESPCfg.BoxColor
            data.Box.Visible = true
        elseif data.Box then data.Box.Visible = false end

        if ESPCfg.Names and data.Name then
            data.Name.Text = player.DisplayName
            data.Name.Position = Vector2.new(top.X, top.Y - 16)
            data.Name.Color = ESPCfg.NameColor
            data.Name.Visible = true
        elseif data.Name then data.Name.Visible = false end

        if ESPCfg.Distance and data.Dist then
            data.Dist.Text = string.format("[%dm]", math.floor(dist))
            data.Dist.Position = Vector2.new(bottom.X, bottom.Y + 2)
            data.Dist.Visible = true
        elseif data.Dist then data.Dist.Visible = false end

        if ESPCfg.Health and data.Health then
            local pct = math.clamp(hum.Health / math.max(hum.MaxHealth, 1), 0, 1)
            local barH = height * pct
            data.Health.From = Vector2.new(boxX - 5, boxY + height)
            data.Health.To = Vector2.new(boxX - 5, boxY + height - barH)
            data.Health.Color = ESPCfg.HealthLow:Lerp(ESPCfg.HealthHigh, pct)
            data.Health.Visible = true
        elseif data.Health then data.Health.Visible = false end

        if ESPCfg.Tracers and data.Tracer then
            data.Tracer.From = Vector2.new(cam.ViewportSize.X / 2, cam.ViewportSize.Y)
            data.Tracer.To = Vector2.new(bottom.X, bottom.Y)
            data.Tracer.Color = ESPCfg.TracerColor
            data.Tracer.Visible = true
        elseif data.Tracer then data.Tracer.Visible = false end
    end
end

