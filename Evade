local function executeTPSafeSpot()
    if LP.Character and LP.Character:FindFirstChild("HumanoidRootPart") then
        if not safePlatform then
            safePlatform = Instance.new("Part")
            safePlatform.Name = "EvadeSafeSpotPlatform" -- Also explicitly avoided by Noclip bypass
            safePlatform.Size = Vector3.new(50, 1, 50)
            safePlatform.Position = Vector3.new(0, 49995, 0)
            safePlatform.Anchored = true
            safePlatform.Transparency = 1
            safePlatform.Parent = Workspace
        end
        LP.Character.HumanoidRootPart.CFrame = CFrame.new(0, 50000, 0)
    end
end

local function executeTPNearest()
    local target = getPlayerByDistance(false)
    if target and target.Character and LP.Character and LP.Character:FindFirstChild("HumanoidRootPart") then
        LP.Character.HumanoidRootPart.CFrame = target.Character.HumanoidRootPart.CFrame
        Library:Notify("Teleported to " .. target.Name)
    else
        Library:Notify("No players found!")
    end
end

