local function getPlayerByDistance(farthest)
    if not (LP.Character and LP.Character:FindFirstChild("HumanoidRootPart")) then return nil end
    local lpPos = LP.Character.HumanoidRootPart.Position
    local targetPlayer = nil
    local targetDist = farthest and 0 or math.huge

    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= LP and plr.Character and plr.Character:FindFirstChild("HumanoidRootPart") then
            local dist = (plr.Character.HumanoidRootPart.Position - lpPos).Magnitude
            if farthest then
                if dist > targetDist then
                    targetDist = dist
                    targetPlayer = plr
                end
            else
                if dist < targetDist then
                    targetDist = dist
                    targetPlayer = plr
                end
            end
        end
    end
    return targetPlayer
end

