-- ESP Functions
local function createESP(target, name, color, textStr)
    local highlight = target:FindFirstChild(name)
    if not highlight then
        highlight = Instance.new("Highlight")
        highlight.Name = name
        highlight.Parent = target
        highlight.FillColor = color
        highlight.OutlineColor = color
        highlight.FillTransparency = 0.5
        highlight.OutlineTransparency = 0
        highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
    end
    highlight.FillColor = color
    highlight.OutlineColor = color
    highlight.Enabled = true

    if textStr and target:IsA("Model") and target.PrimaryPart then
        local billboard = target:FindFirstChild(name .. "_BB")
        if not billboard then
            billboard = Instance.new("BillboardGui")
            billboard.Name = name .. "_BB"
            billboard.Parent = target
            billboard.Size = UDim2.new(0, 150, 0, 30)
            billboard.StudsOffset = Vector3.new(0, 3, 0)
            billboard.AlwaysOnTop = true

            local text = Instance.new("TextLabel")
            text.Parent = billboard
            text.Size = UDim2.new(1, 0, 1, 0)
            text.BackgroundTransparency = 1
            text.TextColor3 = color
            text.TextStrokeTransparency = 0.5
            text.Font = Enum.Font.SourceSansBold
            text.TextSize = 15
        end
        billboard.TextLabel.Text = textStr
        billboard.TextLabel.TextColor3 = color
        billboard.Enabled = true
    end
end

local function removeESP(target, name)
    if target then
        local highlight = target:FindFirstChild(name)
        if highlight then highlight.Enabled = false end
        local billboard = target:FindFirstChild(name .. "_BB")
        if billboard then billboard.Enabled = false end
    end
end

