local GameDataInit = false

local function initGameData()
    if GameDataInit then return end
    GameDataInit = true
    
    task.spawn(function()
        while not (REQ.Contexts and REQ.CharService and REQ.InteractService) do
            local GCs = getgc(true)
            for i = 1, #GCs do
                local v = GCs[i]
                if type(v) == 'table' then
                    if rawget(v, 1) and type(v[1]) == 'table' and rawget(v[1], "CollectableIDs") then
                        REQ.Contexts = v
                    elseif rawget(v, "GetCharacters") then
                        REQ.CharService = v
                    elseif rawget(v, "StartActivate") and rawget(v, "KeyUsed") then
                        REQ.InteractService = v
                    end
                end
                
                if REQ.Contexts and REQ.CharService and REQ.InteractService then
                    break
                end
            end
            task.wait(0.1)
        end
        
        local LowerC = hookfunction or hookfunc
        if LowerC then
            pcall(function()
                local DataReg = require(ReplicatedStorage:WaitForChild("Objects", 9e9):WaitForChild("Game", 9e9):WaitForChild("Character", 9e9):WaitForChild("DataRegistry", 9e9))
                local oldGet; oldGet = LowerC(DataReg.Get, function(p1, value)
                    if value == "ReviveLength" and evadeConfig.ReviveTimeEnabled then
                        return evadeConfig.ReviveTime
                    end
                    return oldGet(p1, value)
                end)
            end)

            pcall(function()
                local oldKey; oldKey = LowerC(REQ.InteractService.KeyUsed, function(p1, p2)
                    if evadeConfig.ReviveAura and p2.Key == "Interact" and p2.KeyCode == Enum.KeyCode.E then
                        return nil
                    end
                    return oldKey(p1, p2)
                end)
            end)
        end
    end)
end
